  "kernels": [
    {
      "id": "action-plan",
      "title": "Plan, then act",
      "engine": "custom",
      "input": "{actions: [{id, kind, label?, cost?, income?, loan?, repeat? | amount?+step?, after?: [ids], params?: {the executor's arguments, carried onto each step}}], cash, loan?, max_loan?, loan_step? (openttd://companies loan_step: the step of repay/repay_loan/borrow actions that give none)}"
    },
    {
      "id": "bayes-update",
      "title": "Bayesian updating",
      "engine": "stochastic",
      "input": "{successes, failures, prior?: \"flat\" | \"jeffreys\" | \"sceptical\" | \"hopeful\" | [a, b], credible?: 0.8 | 0.9 | 0.95 | 0.99, cells?: 100 | 200 | 400}"
    },
    {
      "id": "human-pointing",
      "title": "A hand on the mouse",
      "engine": "custom",
      "input": "{from: [x, y], to: [x, y], width (target px), seed (integer >= 0), model?: {fitts_a, fitts_b, rate_hz, curvature, overshoot_from, tremor, speed}, drag?: boolean}"
    },
    {
      "id": "knapsack-dp",
      "title": "Knapsack by dynamic programming",
      "engine": "grid",
      "input": "the kernel's data form (see its fromData)"
    },
    {
      "id": "pert-monte-carlo",
      "title": "PERT schedule by Monte Carlo",
      "engine": "stochastic",
      "input": "{tasks: [{name?, a, m, b, after: number[]}] in topological order, runs? (default 10000), lambda? (default 4), seed? (default 1)}"
    },
    {
      "id": "simplex-method",
      "title": "Simplex method",
      "engine": "numeric",
      "input": "{A: number[][], b: number[] (each >= 0), c: number[], rule?: \"bland\" | \"dantzig\"}: maximise c\u00b7x, A x <= b, x >= 0"
    },
    {
      "id": "track-planning",
