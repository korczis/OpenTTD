{
  "$id": "https://github.com/korczis/OpenTTD/tools/research/schema/capability-match.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "RESEARCH-ONLY. GENERATED by `battlebrain schema match` from tools/research/mcp-rhai/src/battlebrain_contract.rs; do not edit. Which kernel of the discovered AlgoGlyph catalogue (npm run --silent flow -- kernels) satisfies one Battlebrain capability (I0098): the typed requirement, every kernel considered, the one chosen or the refusal. Written as the params of an inference record with method capability-match.",
  "properties": {
    "adapters": {
      "properties": {
        "owner": {
          "minLength": 1,
          "type": "string"
        },
        "retire_when": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner",
        "retire_when"
      ],
      "type": "object"
    },
    "candidates": {
      "description": "every kernel an adapter declares for this capability, judged against the catalogue",
      "items": {
        "properties": {
          "compatible": {
            "type": "boolean"
          },
          "engine": {
            "description": "as the catalogue lists it; null when absent",
            "type": [
              "string",
              "null"
            ]
          },
          "exact": {
            "type": "boolean"
          },
          "exact_because": {
            "minLength": 1,
            "type": "string"
          },
          "kernel": {
            "minLength": 1,
            "type": "string"
          },
          "mapping": {
            "type": "object"
          },
          "rejected": {
            "items": {
              "properties": {
                "code": {
                  "enum": [
                    "kernel_absent",
                    "engine_mismatch",
                    "unmapped_field",
                    "unknown_field",
                    "input_shape_drift"
                  ]
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "path",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "shape": {
            "description": "verified: the catalogue's input shape declares every mapped key",
            "enum": [
              "verified",
              "opaque",
              null
            ]
          },
          "units": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kernel",
          "engine",
          "compatible",
          "exact",
          "shape",
          "mapping",
          "rejected"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "catalogue": {
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "kernels": {
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "const": "npm run --silent flow -- kernels"
        }
      },
      "required": [
        "digest",
        "commit",
        "source",
        "kernels"
      ],
      "type": "object"
    },
    "chosen": {
      "type": [
        "string",
        "null"
      ]
    },
    "ranking": {
      "description": "the ranking rules applied among compatible kernels, in order",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "refusal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "properties": {
            "code": {
              "enum": [
                "unknown_capability",
                "no_adapter",
                "kernel_expired",
                "no_match",
                "ambiguous_capability"
              ]
            },
            "message": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "path",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "requirement": {
      "properties": {
        "goal": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "inputs": {
          "items": {
            "description": "an amount kind carries a unit; no other kind does",
            "properties": {
              "doc": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "amount",
                  "amount[]",
                  "number",
                  "number[]",
                  "index[]",
                  "tile",
                  "resource",
                  "status",
                  "list"
                ]
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "unit": {
                "enum": [
                  "money",
                  "money_per_year",
                  "tiles",
                  "game_days",
                  "ms",
                  "items",
                  "ratio"
                ]
              }
            },
            "required": [
              "name",
              "kind",
              "doc"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "description": "an amount kind carries a unit; no other kind does",
            "properties": {
              "doc": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "amount",
                  "amount[]",
                  "number",
                  "number[]",
                  "index[]",
                  "tile",
                  "resource",
                  "status",
                  "list"
                ]
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "unit": {
                "enum": [
                  "money",
                  "money_per_year",
                  "tiles",
                  "game_days",
                  "ms",
                  "items",
                  "ratio"
                ]
              }
            },
            "required": [
              "name",
              "kind",
              "doc"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "used_by": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "schema": {
      "const": "capability-match/v1"
    },
    "unadapted": {
      "description": "the catalogue's kernels no adapter declares for this capability: considered, never chosen",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "why": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "requirement",
    "catalogue",
    "adapters",
    "ranking",
    "candidates",
    "unadapted",
    "chosen",
    "why",
    "refusal"
  ],
  "title": "capability-match/v1",
  "type": "object",
  "x-invariant": "exactly one of chosen and refusal is non-null; chosen is a compatible candidate"
}
