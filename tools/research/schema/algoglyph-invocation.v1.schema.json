{
  "$id": "https://github.com/korczis/OpenTTD/tools/research/schema/algoglyph-invocation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "RESEARCH-ONLY. GENERATED by `battlebrain schema invocation` from tools/research/mcp-rhai/src/battlebrain_contract.rs; do not edit. The caller-side envelope of one AlgoGlyph kernel call (I0095). AlgoGlyph is used from outside: the kernel must be in the catalogue the runner reported (npm run --silent flow -- kernels) at that checkout.",
  "else": {
    "required": [
      "errors"
    ]
  },
  "if": {
    "properties": {
      "status": {
        "const": "ok"
      }
    }
  },
  "properties": {
    "budget": {
      "properties": {
        "timeout_ms": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "timeout_ms"
      ],
      "type": "object"
    },
    "catalogue": {
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "commit"
      ],
      "type": "object"
    },
    "duration_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "input": {
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "enum": [
              "money",
              "money_per_year",
              "tiles",
              "game_days",
              "ms",
              "items",
              "ratio"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "digest",
        "units"
      ],
      "type": "object"
    },
    "kernel": {
      "properties": {
        "engine": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "engine"
      ],
      "type": "object"
    },
    "output": {
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "type": "object"
    },
    "schema": {
      "const": "algoglyph-invocation/v1"
    },
    "status": {
      "enum": [
        "ok",
        "refused",
        "timeout",
        "invalid_output",
        "unknown_kernel"
      ]
    }
  },
  "required": [
    "schema",
    "kernel",
    "catalogue",
    "input",
    "budget",
    "status"
  ],
  "then": {
    "required": [
      "output"
    ]
  },
  "title": "algoglyph-invocation/v1",
  "type": "object"
}
