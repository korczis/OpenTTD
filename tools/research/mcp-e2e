#!/usr/bin/env bash
# RESEARCH-ONLY end-to-end run of the embedded MCP server (ADR 0008), fully automatic:
#
#   1. a headless dedicated server from an MCP-enabled build, with its MCP server started and a
#      company AI (PrismaticAI) playing on its own,
#   2. the control window at http://127.0.0.1:<panel-port>/ (tools/research/mcp-panel): live state,
#      companies, resources and tools, the approval-gated pause, auto-approve, and a developer
#      console on ~ (OpenTTD console commands, raw MCP, Rhai scripts),
#   3. an OpenTTD GUI client joined to the server as a spectator, full screen, with its own MCP
#      server (started by its own autoexec.scr; token in a 0600 file), so the game is visible and
#      its camera is driven: rhai/director.rhai moves it to every route the bot builds, and
#      rhai/narrator.rhai reports in the game's chat what the bot does, and rhai/steward.rhai asks
#      the owner yes/no questions in the game window and acts on the answers, and
#      rhai/ask_relay.rhai answers what the owner asks in the game (the toolbar's Ask item, or
#      plan/ask/do in the ~ console) through the planner, as news and in the console.
#
# Usage: tools/research/mcp-e2e [--bin <openttd>] [--no-gui] [--no-browser] [--auto-approve] [--window WxH]
#                               [--no-director] [--view-port N (default: a free port)]
#                               [--panel-port 8800] [--mcp-port 8731] [--game-port 3979] [--seed N]
#                               [--no-plan-bot (start the bot without the planner's air pair, e.g. as the
#                                baseline of an A/B run)]
#                               [--arm-input (the owner's switch: the GUI client accepts openttd.input.*,
#                                so the panel's /ui page and scripts can press its widgets; off by default)]
#                               [--instances N (default 1: N-1 more headless stacks with bots, free
#                                ports, all in the discovery registry, listed by every panel)]
#                               [--null-client (with --no-gui: a client without a window, null video
#                                driver, with its own MCP, attached to the panel; every extra instance
#                                of --instances gets one)]
#                               [--rust-panel (accepted and ignored: the panel is always mcp-panel from
#                                tools/research/mcp-rhai since server.py was removed, I0035)]
#                               [--ask-countdown N (default 10: the bot's "Your bot asks" questions
#                                confirm themselves with yes after N seconds, a bar shows the time
#                                left; a click answers or stops it; 0 makes every question wait)]
#                               [--gfx NAME (default OpenGFX: the GUI client's base graphics set,
#                                forced on every start, so no saved choice changes it; e.g. NoirGFX)]
#                               [--coplay (the GUI client plays the bot's company together with the
#                                bot instead of watching: the server opens it with `research_coplay
#                                allow`, the client joins it, and the co-play services start:
#                                $MCP_SERVICES, default "arena replan watchdog"; research/coplay.md)]
#                               [--approval-deadline DAYS[:keep|approve] (the operator's standing verdict for an approval
#                                nobody answers within DAYS game days, read by the server at start as
#                                PRISMATIC_MCP_APPROVAL_DEADLINE; default 30:keep; research/mechanisms/approval-gate.md)]
#                               [--lineup "AI,AI,..." (the other companies of a new world, each started with
#                                the server's `start_ai` once the bot's company exists; a name is an AI's
#                                own name as `list_ai` shows it; with --lineup the arena is not among the
#                                default co-play services, since the lineup is given; research/coplay.md)]
#                               [--load FILE (start from a savegame instead of a new world: its AI
#                                companies play on and no new bot is started; with --coplay the
#                                client joins the bot company the game reports; research/coplay.md)]
#                               [--env (print the Majordomus environment the stack would run with:
#                                PRISMATIC_MCP_SUPERVISOR, MAJORDOMUS_URL, MAJORDOMUS_SESSION, each
#                                derived when unset; then exit, starting nothing; research/mcp-control.md)]
# Stop with Ctrl-C: the panel stops the server, and the GUI client is closed.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="$ROOT_DIR/build-gate-research/openttd"
PANEL_PORT=8800 MCP_PORT=8731 GAME_PORT=3979 SEED="$RANDOM"
GUI=1 BROWSER=1 AUTO=() WINDOW="" DIRECTOR=1 VIEW_PORT="" INSTANCES=1 EXTRA_PIDS=() ARM_INPUT=0 PLAN=() NULL_CLIENT=0
PANEL_IMPL="${MCP_PANEL:-rust}"
ASK_COUNTDOWN=10 GFX=OpenGFX COPLAY=0 LOAD=() ENV_ONLY=0 LINEUP=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin) BIN="$2"; shift 2 ;;
    --no-gui) GUI=0; shift ;;
    --no-browser) BROWSER=0; shift ;;
    --auto-approve) AUTO=(--auto-approve); shift ;;
    --window) WINDOW="${2:?--window needs WxH}"; shift 2 ;;
    --no-director) DIRECTOR=0; shift ;;
    --view-port) VIEW_PORT="${2:?--view-port needs a port}"; shift 2 ;;
    --panel-port) PANEL_PORT="$2"; shift 2 ;;
    --mcp-port) MCP_PORT="$2"; shift 2 ;;
    --game-port) GAME_PORT="$2"; shift 2 ;;
    --seed) SEED="$2"; shift 2 ;;
    --instances) INSTANCES="${2:?--instances needs a number}"; shift 2 ;;
    --arm-input) ARM_INPUT=1; shift ;;
    --no-plan-bot) PLAN=(--no-plan-bot); shift ;;
    --rust-panel) PANEL_IMPL=rust; shift ;;
    --null-client) NULL_CLIENT=1; shift ;;
    --ask-countdown) ASK_COUNTDOWN="${2:?--ask-countdown needs seconds (0 = off)}"; shift 2 ;;
    --gfx) GFX="${2:?--gfx needs a base graphics set name}"; shift 2 ;;
    --coplay) COPLAY=1; shift ;;
    --lineup) LINEUP="${2:?--lineup needs a comma-separated list of AI names}"; shift 2 ;;
    --approval-deadline) [[ "${2:-}" =~ ^[0-9]{1,4}(:(keep|approve))?$ ]] || { echo "mcp-e2e: --approval-deadline takes <game days>[:keep|approve]" >&2; exit 2; }
                         export PRISMATIC_MCP_APPROVAL_DEADLINE="$2"; shift 2 ;;
    --load) [[ -f "${2:?--load needs a savegame file}" ]] || { echo "mcp-e2e: no savegame at $2" >&2; exit 2; }
            LOAD=(--load "$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"); shift 2 ;;
    --env) ENV_ONLY=1; shift ;;
    -h|--help) sed -n '2,/^# Stop with/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "mcp-e2e: unknown option: $1" >&2; exit 2 ;;
  esac
done
[[ "$ASK_COUNTDOWN" =~ ^[0-9]+$ && "$ASK_COUNTDOWN" -le 600 ]] || { echo "mcp-e2e: --ask-countdown takes 0 to 600 seconds" >&2; exit 2; }

# Supervision: every process of the stack names, in its registry record, the Majordomus task the
# stack runs under (I0041). The servers, clients and panels copy PRISMATIC_MCP_SUPERVISOR, a JSON
# object, into their record's `supervisor`; the panel's /api/instances and the hub's
# /hub/instances show it. Taken from `majordomus context --json` in this checkout when a task is
# active there; a caller's own PRISMATIC_MCP_SUPERVISOR wins.
#
# The mesh: the panel's Rhai scripts and services write typed Majordomus mesh records
# (mesh_record_write, e.g. replan.rhai's plan), and the panel mirrors every directive into them
# (src/panel_mesh.rs), both only with $MAJORDOMUS_URL and $MAJORDOMUS_SESSION set. Derived here
# when unset: the URL is the server `majordomus serve ensure` names for this checkout, the session
# is the active task's mesh session `task-<id>`, under which `majordomus start` claimed the task's
# scope on that server (prismatic-majordomus docs/MESH.md): a write is admitted only inside the
# writing session's live claims. A caller's own value wins; an empty one keeps the stack off the
# mesh. Without a server or an active task the variable stays unset, and this says why.
MJ=0
[[ -f "$ROOT_DIR/.ai/manifest.yaml" ]] && command -v majordomus > /dev/null && MJ=1
MJ_TASK=""   # the active task of this checkout (`majordomus context --json` .task), read once
if [[ "$MJ" == 1 ]] && [[ -z "${PRISMATIC_MCP_SUPERVISOR:-}" || -z "${MAJORDOMUS_SESSION+set}" ]]; then
  MJ_TASK="$(cd "$ROOT_DIR" && majordomus context --json 2>/dev/null | jq -c 'select(.task.outcome == "active") | .task' 2>/dev/null || true)"
fi
if [[ -z "${PRISMATIC_MCP_SUPERVISOR:-}" && "$MJ" == 1 ]]; then
  if [[ -n "$MJ_TASK" ]]; then
    PRISMATIC_MCP_SUPERVISOR="$(jq -c --arg wt "$ROOT_DIR" '{by: "majordomus", task: .id, title: .task, owner: .owner, worktree: $wt}' <<<"$MJ_TASK")"
    export PRISMATIC_MCP_SUPERVISOR
  else
    echo "    no active Majordomus task in $ROOT_DIR: the instances run unsupervised (majordomus start ... first)"
  fi
fi
[[ -n "${PRISMATIC_MCP_SUPERVISOR:-}" ]] && echo "    supervised by: $(jq -r '"\(.by) \(.task) — \(.title)"' <<<"$PRISMATIC_MCP_SUPERVISOR" 2>/dev/null || echo "$PRISMATIC_MCP_SUPERVISOR")"
MESH_WHY=()
if [[ -z "${MAJORDOMUS_URL+set}" ]]; then
  if [[ "$MJ" == 1 ]]; then
    MAJORDOMUS_URL="$(majordomus serve ensure --format json --repo "$ROOT_DIR" 2>/dev/null | jq -r '.url // empty' 2>/dev/null || true)"
    if [[ -n "$MAJORDOMUS_URL" ]]; then
      export MAJORDOMUS_URL
    else
      unset MAJORDOMUS_URL
      MESH_WHY+=("\`majordomus serve ensure\` named no server for $ROOT_DIR")
    fi
  else
    MESH_WHY+=("no majordomus or no .ai/manifest.yaml in $ROOT_DIR, so no server to name")
  fi
elif [[ -z "$MAJORDOMUS_URL" ]]; then
  MESH_WHY+=("MAJORDOMUS_URL is set empty")
fi
if [[ -z "${MAJORDOMUS_SESSION+set}" ]]; then
  if [[ -n "$MJ_TASK" ]]; then
    MAJORDOMUS_SESSION="task-$(jq -r '.id' <<<"$MJ_TASK")"
    export MAJORDOMUS_SESSION
  else
    MESH_WHY+=("no active Majordomus task in $ROOT_DIR, so no session (majordomus start ... first)")
  fi
elif [[ -z "$MAJORDOMUS_SESSION" ]]; then
  MESH_WHY+=("MAJORDOMUS_SESSION is set empty")
fi
if [[ ${#MESH_WHY[@]} -eq 0 ]]; then
  echo "    mesh records: $MAJORDOMUS_URL as session $MAJORDOMUS_SESSION (Rhai mesh_record_write; the panel mirrors directives)"
else
  why="$(printf '%s; ' "${MESH_WHY[@]}")"
  echo "    mesh records off: ${why%; }"
fi
if [[ "$ENV_ONLY" == 1 ]]; then
  for var in PRISMATIC_MCP_SUPERVISOR MAJORDOMUS_URL MAJORDOMUS_SESSION; do
    if [[ -n "${!var+set}" ]]; then printf '%s=%s\n' "$var" "${!var}"; else printf '%s unset\n' "$var"; fi
  done
  exit 0
fi

PANEL_DIR="$ROOT_DIR/tools/research/mcp-panel"
[[ -x "$BIN" ]] || { echo "mcp-e2e: no binary at $BIN; run tools/gate.sh research first" >&2; exit 3; }
if [[ "$(strings "$BIN" | grep -c 'prismatic_mcp')" -eq 0 ]]; then
  echo "mcp-e2e: $BIN lacks the MCP server; build with -DOPTION_PRISMATIC_MCP_SERVER=ON" >&2; exit 3
fi
if ! ls "$HOME/Documents/OpenTTD/baseset/"opengfx* >/dev/null 2>&1; then
  echo "mcp-e2e: no OpenGFX in ~/Documents/OpenTTD/baseset (see research/baseset-prerequisite-macos.md)" >&2; exit 3
fi
[[ -d "$PANEL_DIR/node_modules/flowbite" ]] || (cd "$PANEL_DIR" && npm ci --no-audit --no-fund --silent)
[[ -f "$PANEL_DIR/static/app.css" ]] || (cd "$PANEL_DIR" && tailwindcss -i input.css -o static/app.css --minify)

TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-e2e.XXXXXX")"
PANEL_PID="" GUI_PID="" HELPER_PIDS=()
# The whole stack runs one snapshot of the binary. A rebuild of the shared build directory (a gate
# run, a commit changing the revision) otherwise reaches a client that the supervisor restarts, and
# the server, still on the old revision, refuses it ("wrong revision", seen 2026-11-16). The copy
# sits next to the original so the game still finds its lang/ files.
SNAP="$(dirname "$BIN")/openttd-e2e-$$"
cp "$BIN" "$SNAP"
BIN="$SNAP"
cleanup() {
  for p in ${EXTRA_PIDS[@]+"${EXTRA_PIDS[@]}"}; do kill -TERM "$p" 2>/dev/null || true; done
  for p in ${HELPER_PIDS[@]+"${HELPER_PIDS[@]}"} ${GUI_PID:+"$GUI_PID"}; do
    pkill -P "$p" 2>/dev/null || true   # the supervised child first, then its supervisor loop
    kill "$p" 2>/dev/null || true
  done
  [[ -n "$PANEL_PID" ]] && kill -TERM "$PANEL_PID" 2>/dev/null || true
  wait 2>/dev/null || true
  rm -rf "$TMP"
  rm -f "$SNAP"
}
trap cleanup EXIT INT TERM

# A port another service already holds (majordomus mcp holds 8741, a second stack holds 8800) is
# replaced by a free one, so several stacks run side by side as one cluster.
port_free() { ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
any_port() { python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
for var in PANEL_PORT MCP_PORT GAME_PORT; do
  if ! port_free "${!var}"; then
    new="$(any_port)"
    echo "    $var ${!var} is taken; using $new"
    printf -v "$var" '%s' "$new"
  fi
done

# AlgoGlyph's flow runner: the planner's portfolio then runs on its knapsack-dp kernel (the answer
# names the solver). AlgoGlyph is the submodule tools/research/vendor/algoglyph, pinned at one commit
# whose runner lists every kernel the stack uses (tools/research/vendor/algoglyph.pin.json, `needs`;
# I0227, ADR 0039). `algoglyph-pin runner` names the installed checkout cleanly at that commit: the
# submodule, else ~/dev/algoglyph-wt/main or ~/dev/algoglyph when one of them is at the pin. A
# checkout at any other commit is passed over, never used silently: the pin is the only version the
# fork trusts. MCP_ALGOGLYPH_DIR overrides (an experiment against another version); none: built-in.
if [[ -z "${MCP_ALGOGLYPH_DIR:-}" ]]; then
  if d="$(cd "$ROOT_DIR" && tools/research/algoglyph-pin runner)"; then
    export MCP_ALGOGLYPH_DIR="$d"
  else
    echo "    no AlgoGlyph runner at the pin (tools/research/algoglyph-pin install); the planner uses its built-in solver" >&2
  fi
fi
[[ -n "${MCP_ALGOGLYPH_DIR:-}" ]] && echo "    AlgoGlyph runner: $MCP_ALGOGLYPH_DIR"

# The stack's run token (mcp-panel --run-token-file, panel.rs RUN_TOKEN_HEADER): the panel and its
# helpers (mcp-rhai --panel-token-file) read it from a 0600 file of this run, so it is on no command
# line, in no log and in no environment. It names a caller as this stack's own and never opens an
# owner's route (approving, auto-approve, the approvers).
make_run_token() {
  local file="$1"
  ( umask 077; od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$file" )
  [[ -s "$file" ]]
}

# A client's personal directory holds its secrets.cfg, where the owner's client keeps the key that
# makes it the approver (#228): only the owner may read it. The client is started under umask 077,
# and this closes what was made before or around it.
seal_client_home() {
  local home="$1"
  [[ -d "$home" ]] || return 0
  chmod 700 "$home"
  find "$home" -name secrets.cfg -type f -exec chmod 600 {} +
}

# Every secrets.cfg under `home` that its group or others may read, one per line; none is the
# answer the stack checks for once the client has started.
open_client_secrets() {
  local home="$1"
  [[ -d "$home" ]] || return 0
  find "$home" -name secrets.cfg -type f \( -perm -040 -o -perm -020 -o -perm -010 -o -perm -004 -o -perm -002 -o -perm -001 \)
}

# A POST of this stack's own to its panel: the run token goes in X-Panel-Token, read from its file
# by the shell itself and handed to curl on stdin, so no command line or process list shows it.
stack_post() {
  local url="$1" body="$2"
  printf 'X-Panel-Token: %s\n' "$(tr -d '[:space:]' < "$RUN_TOKEN")" \
    | curl -s -X POST -H @- -H 'Content-Type: application/json' -d "$body" "$url"
}

# $MCP_E2E_RUN_TOKEN_FILE lets a caller that drives the stack (mcp-duel) hold the token too.
RUN_TOKEN="${MCP_E2E_RUN_TOKEN_FILE:-$TMP/panel-run-token}"
make_run_token "$RUN_TOKEN" || { echo "mcp-e2e: could not make the run token ($RUN_TOKEN)" >&2; exit 1; }

# The panel: mcp-panel from tools/research/mcp-rhai (I0035; server.py, its Python predecessor, is
# gone). One cargo build makes it and mcp-rhai, which runs the director and the other helpers; in a
# fresh worktree that build takes minutes, later ones seconds. More instances follow.
[[ "$PANEL_IMPL" == rust ]] || { echo "mcp-e2e: MCP_PANEL=$PANEL_IMPL: the only panel is the Rust one (server.py was removed, I0035)" >&2; exit 2; }
export MCP_PANEL="$PANEL_IMPL"
[[ -x "$ROOT_DIR/tools/research/mcp-rhai/target/release/mcp-panel" ]] || echo "==> building the panel (tools/research/mcp-rhai, first build takes minutes)"
cargo build --offline --release --quiet --manifest-path "$ROOT_DIR/tools/research/mcp-rhai/Cargo.toml"
PANEL_CMD=("$ROOT_DIR/tools/research/mcp-rhai/target/release/mcp-panel")
echo "==> panel ($PANEL_IMPL) + dedicated server ($([[ ${#LOAD[@]} -gt 0 ]] && echo "savegame ${LOAD[1]}" || echo "seed $SEED"))"
"${PANEL_CMD[@]}" --bin "$BIN" --panel-port "$PANEL_PORT" --mcp-port "$MCP_PORT" --run-token-file "$RUN_TOKEN" \
  --game-port "$GAME_PORT" --seed "$SEED" ${AUTO[@]+"${AUTO[@]}"} ${PLAN[@]+"${PLAN[@]}"} ${LOAD[@]+"${LOAD[@]}"} &
PANEL_PID=$!

URL="http://127.0.0.1:$PANEL_PORT"
for ((i = 0; i < 180; i++)); do
  if curl -s "$URL/api/status" | grep -q '"mcp_up": true'; then break; fi
  kill -0 "$PANEL_PID" 2>/dev/null || { echo "mcp-e2e: the panel exited" >&2; exit 1; }
  sleep 1
done
curl -s "$URL/api/status" | grep -q '"mcp_up": true' || { echo "mcp-e2e: MCP did not come up" >&2; exit 1; }
echo "==> MCP up; control window: $URL"

# More instances of the cluster: each is this launcher, headless, on free ports, with its own bot
# and a windowless client;
# every panel lists them all (GET /api/instances) and can drive any of them.
for ((n = 2; n <= INSTANCES; n++)); do
  MCP_E2E_RUN_TOKEN_FILE="" "${BASH_SOURCE[0]}" --bin "$BIN" --no-gui --no-browser --null-client --seed "$((SEED + n))" \
    > "$TMP/instance-$n.log" 2>&1 &
  EXTRA_PIDS+=($!)
  echo "==> instance $n of $INSTANCES starting (log $TMP/instance-$n.log)"
done
# register_owner_approver URL CLIENT_ID SECRET_FILE: makes the owner's client an in-game approver
# through the panel's owner route POST /api/approvers (/api/console refuses every approvers line,
# #258). The secret comes from the owner's own 0600 file; curl reads the header from stdin, so the
# secret is never in a command line, a process list or this script's output.
# Tested by tools/research/test_mcp_e2e_approver.py, which runs this function as written here.
register_owner_approver() {
  local url="$1" id="$2" file="$3" reg
  if [[ -r "$file" && -s "$file" ]]; then
    reg="$(printf 'X-Panel-Owner: %s\n' "$(tr -d '[:space:]' < "$file")" \
      | curl -s -X POST -H @- -H 'Content-Type: application/json' -d "{\"add\":$id}" "$url/api/approvers" \
      | jq -r '.error // ([.output[]? | select(test("approver"))] | last) // empty' 2>/dev/null || true)"
    echo "==> approver: the owner's client #$id (${reg:-no answer})"
  else
    echo "mcp-e2e: --coplay: no owner secret file ($file), so the owner's client is no approver; approve in the panel" >&2
  fi
}

# The owner's browser signs in by opening the panel with the owner secret once (the cookie it sets
# is what Approve and auto-approve check). The secret is read from the owner's own 0600 file, which
# mcp-panel keeps stable across restarts, and never printed; without the file the plain URL opens.
# The owner's browser signs in through a one-time link (POST /api/owner/once with the secret on
# curl's stdin): `?once=<nonce>` sets the cookie once within a minute and redirects to the page
# without the query, so the secret is in no URL, browser history or process list. Without the file
# (or a panel that makes no link) the plain URL opens.
open_owner_page() {
  local url="$1" file="$2" once=""
  if [[ -r "$file" && -s "$file" ]]; then
    once="$(printf 'X-Panel-Owner: %s\n' "$(tr -d '[:space:]' < "$file")" \
      | curl -s -X POST -H @- -H 'Content-Type: application/json' -d '{}' "$url/api/owner/once" \
      | jq -r '.once // empty' 2>/dev/null || true)"
  fi
  if [[ -n "$once" ]]; then
    "${OPEN_CMD:-open}" "$url/?once=$once"
    echo "==> the panel opened in your browser, signed in as the owner (a one-time link; the secret stays in $file)"
  else
    "${OPEN_CMD:-open}" "$url"
  fi
}

OWNER_SECRET_FILE="${PRISMATIC_PANEL_OWNER_SECRET_FILE:-$HOME/.config/prismatic/panel-owner-secret}"
if [[ "$BROWSER" == 1 ]]; then
  open_owner_page "$URL" "$OWNER_SECRET_FILE"
fi

if [[ "$GUI" == 1 ]]; then
  # Full screen at the display's size unless --window WxH asks for a window.
  if [[ -n "$WINDOW" ]]; then FULL=false RES="$WINDOW"; else
    FULL=true
    RES="$(system_profiler SPDisplaysDataType 2>/dev/null | sed -nE 's/.*UI Looks like: ([0-9]+) x ([0-9]+).*/\1x\2/p' | head -1)"
    [[ -n "$RES" ]] || RES=1920x1080
  fi
  printf '[network]\nclient_name = owner-view\n[misc]\nfullscreen = %s\nresolution = %s\n[gui]\nautosave = off\n' \
    "$FULL" "${RES/x/,}" > "$TMP/client.cfg"
  # The client gets a personal directory of its own (OpenTTD reads it from $HOME), so its
  # autoexec.scr starts its own MCP server without touching the server's or the owner's.
  CHOME="$TMP/client-home"; CPD="$CHOME/Documents/OpenTTD"
  mkdir -p "$CPD/scripts"
  ln -s "$HOME/Documents/OpenTTD/baseset" "$CPD/baseset"
  VIEW_TOKEN="$TMP/view-token.json"
  # A free loopback port unless one is given: fixed ports collide with other local services.
  [[ -n "$VIEW_PORT" ]] || VIEW_PORT="$(python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
  printf 'prismatic_mcp start %s %s\n' "$VIEW_PORT" "$VIEW_TOKEN" > "$CPD/scripts/autoexec.scr"
  # The owner's auto-confirm: the bot's questions answer themselves with yes after the countdown
  # (openttd.view.ask.auto through the client's `mcp` console command), on every client start.
  if [[ "$ASK_COUNTDOWN" -gt 0 ]]; then
    printf 'mcp view.ask.auto answer=yes countdown=%s\n' "$ASK_COUNTDOWN" >> "$CPD/scripts/autoexec.scr"
  fi
  # Co-play (research/coplay.md): the client joins the bot's own company, which the server opens
  # for it, so the owner and the bot play one company. The company is the running bot's, read from
  # the game (/api/bots), never assumed; without --coplay the client watches as a spectator.
  JOIN=255 AS="as a spectator"
  if [[ "$COPLAY" == 1 ]]; then
    BOT_COMPANY=""
    for ((i = 0; i < 120; i++)); do
      BOT_COMPANY="$(curl -s "$URL/api/bots" | jq -r '.running[0].id // empty' 2>/dev/null || true)"
      [[ -n "$BOT_COMPANY" ]] && break
      sleep 1
    done
    [[ -n "$BOT_COMPANY" ]] || { echo "mcp-e2e: --coplay: no bot company appeared in 120 s" >&2; exit 1; }
    JOIN=$((BOT_COMPANY + 1))
    OPENED="$(stack_post "$URL/api/console" "{\"command\":\"research_coplay allow $JOIN\"}" \
      | jq -r '.output[]? | select(startswith("research_coplay"))' 2>/dev/null || true)"
    grep -Eq "open=\[([0-9]+,)*$JOIN(,[0-9]+)*\]" <<<"$OPENED" \
      || { echo "mcp-e2e: --coplay: the server did not open company $JOIN (${OPENED:-no answer}; a build without research_coplay?)" >&2; exit 1; }
    sed -i '' 's/^client_name = owner-view$/client_name = owner/' "$TMP/client.cfg"
    AS="into the bot's company $JOIN (co-play: $OPENED)"
  fi
  echo "==> GUI client ($RES, fullscreen=$FULL, graphics $GFX, own MCP on 127.0.0.1:$VIEW_PORT) joining 127.0.0.1:$GAME_PORT $AS"
  if [[ "$ASK_COUNTDOWN" -gt 0 ]]; then
    echo "    the bot's questions confirm themselves with yes after ${ASK_COUNTDOWN} s (--ask-countdown 0 makes them wait)"
  fi
  # Supervised: the client comes back whenever it exits (closed window, crash) while the panel runs;
  # its autoexec.scr writes a fresh token file each time, which the director rereads on every call.
  # Under umask 077: what the client writes (its secrets.cfg, with the approver key) only the owner reads.
  seal_client_home "$CHOME"
  (
    umask 077
    while kill -0 "$PANEL_PID" 2>/dev/null; do
      # -I on every start: the client saves its config on exit, so a set picked once in Game
      # Options would otherwise stick to every later start of this run.
      HOME="$CHOME" PRISMATIC_MCP_INPUT="$ARM_INPUT" "$BIN" -c "$TMP/client.cfg" -I "$GFX" -r "$RES" -n "127.0.0.1:$GAME_PORT#$JOIN" >> "$TMP/client.log" 2>&1 &
      CPID=$!
      # Bring it to the front (a full-screen window opens on a Space of its own on macOS), and
      # attach it to the panel, which shows and drives its view.
      for ((j = 0; j < 30; j++)); do [[ -s "$VIEW_TOKEN" ]] && break; sleep 1; done
      seal_client_home "$CHOME"
      OPEN_SECRETS="$(open_client_secrets "$CHOME")"
      [[ -z "$OPEN_SECRETS" ]] || echo "mcp-e2e: readable beyond the owner: $OPEN_SECRETS" >&2
      osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $CPID) to true" >/dev/null 2>&1 || true
      stack_post "$URL/api/view/attach" "{\"token_file\":\"$VIEW_TOKEN\"}" >/dev/null || true
      # `|| rc=$?`: under set -e a crashed client (wait returns 134) used to end this loop, so the
      # supervisor stopped restarting exactly when it was needed (seen 2026-11-22).
      rc=0; wait "$CPID" || rc=$?
      echo "client exited with $rc; restarting in 3 s" >> "$TMP/client.log"
      rm -f "$VIEW_TOKEN"
      sleep 3
    done
  ) &
  GUI_PID=$!
  # Who approves in a co-play game (research/coplay.md "Who approves"; the owner's decision of
  # 2026-11-22): the owner's own client, unarmed, registered on the server as an approver, so the
  # control window, the toolbar, the console and the chat decide for it. An armed client takes
  # scripted input, so it is never registered: with --arm-input the owner approves in the panel.
  if [[ "$COPLAY" == 1 && "$ARM_INPUT" == 1 ]]; then
    echo "    --arm-input: the owner's client takes scripted input, so it is not an approver; approve in the panel ($URL)"
  elif [[ "$COPLAY" == 1 ]]; then
    OWNER_ID=""
    for ((i = 0; i < 60; i++)); do
      OWNER_ID="$(stack_post "$URL/api/console" '{"command":"clients"}' \
        | jq -r '.output[]?' 2>/dev/null | sed -nE "s/^Client #([0-9]+) +name: 'owner' .*/\1/p" || true)"
      OWNER_ID="${OWNER_ID%%$'\n'*}"
      [[ -n "$OWNER_ID" ]] && break
      sleep 1
    done
    if [[ -n "$OWNER_ID" ]]; then
      # /api/console refuses every approvers line (#258): the owner's route registers it.
      register_owner_approver "$URL" "$OWNER_ID" "$OWNER_SECRET_FILE"
    else
      echo "mcp-e2e: --coplay: the owner's client did not join within 60 s; no approver registered (approve in the panel)" >&2
    fi
  fi
  RHAI="$ROOT_DIR/tools/research/mcp-rhai/target/release/mcp-rhai"
  if [[ "$DIRECTOR" == 1 && -x "$RHAI" ]]; then
    for ((i = 0; i < 60; i++)); do [[ -s "$VIEW_TOKEN" ]] && break; sleep 1; done
    if [[ -s "$VIEW_TOKEN" ]]; then
      echo "==> director (camera), narrator (chat and news), steward (asks you in the game) and ask relay (answers you)"
      # Supervised the same way: a helper that stops is started again.
      ( while kill -0 "$PANEL_PID" 2>/dev/null; do
          MCP_VIEW_TOKEN="$VIEW_TOKEN" "$RHAI" --panel "$URL" --panel-token-file "$RUN_TOKEN" "$PANEL_DIR/rhai/director.rhai" >> "$TMP/director.log" 2>&1
          sleep 3
        done ) &
      HELPER_PIDS+=($!)
      ( while kill -0 "$PANEL_PID" 2>/dev/null; do
          MCP_PANEL_URL="$URL" "$RHAI" --panel "$URL" --panel-token-file "$RUN_TOKEN" "$PANEL_DIR/rhai/narrator.rhai" >> "$TMP/narrator.log" 2>&1
          sleep 3
        done ) &
      HELPER_PIDS+=($!)
      ( while kill -0 "$PANEL_PID" 2>/dev/null; do
          "$RHAI" --panel "$URL" --panel-token-file "$RUN_TOKEN" "$PANEL_DIR/rhai/steward.rhai" >> "$TMP/steward.log" 2>&1
          sleep 3
        done ) &
      HELPER_PIDS+=($!)
      # What the owner asks in the game (the toolbar's Ask item, or plan/ask/do in the ~ console)
      # is queued in the client's openttd://ui/requests; the relay answers it through the planner.
      ( while kill -0 "$PANEL_PID" 2>/dev/null; do
          MCP_VIEW_TOKEN="$VIEW_TOKEN" "$RHAI" --panel "$URL" --panel-token-file "$RUN_TOKEN" "$PANEL_DIR/rhai/ask_relay.rhai" >> "$TMP/ask_relay.log" 2>&1
          sleep 3
        done ) &
      HELPER_PIDS+=($!)
      echo "    logs: $TMP/director.log $TMP/narrator.log $TMP/steward.log $TMP/ask_relay.log"
    else
      echo "mcp-e2e: the GUI client wrote no MCP token file; no director" >&2
    fi
  fi
fi

# A client without a window: the null video driver runs the game loop, the client joins the
# server as a spectator, its own MCP server announces it, and the panel attaches it, so a headless
# instance of a cluster has its client too. Supervised like the GUI client.
if [[ "$GUI" == 0 && "$NULL_CLIENT" == 1 ]]; then
  NHOME="$TMP/null-client-home"; NPD="$NHOME/Documents/OpenTTD"
  mkdir -p "$NPD/scripts"
  ln -s "$HOME/Documents/OpenTTD/baseset" "$NPD/baseset"
  NULL_TOKEN="$TMP/null-client-token.json"
  printf 'prismatic_mcp start %s %s\n' "$(any_port)" "$NULL_TOKEN" > "$NPD/scripts/autoexec.scr"
  printf '[network]\nclient_name = cluster-client\n[gui]\nautosave = off\n' > "$TMP/null-client.cfg"
  echo "==> windowless client (null video driver, own MCP) joining 127.0.0.1:$GAME_PORT as a spectator"
  seal_client_home "$NHOME"
  (
    umask 077
    while kill -0 "$PANEL_PID" 2>/dev/null; do
      HOME="$NHOME" "$BIN" -v null:ticks=2000000000 -s null -m null -c "$TMP/null-client.cfg" \
        -n "127.0.0.1:$GAME_PORT#255" >> "$TMP/null-client.log" 2>&1 &
      CPID=$!
      for ((j = 0; j < 60; j++)); do [[ -s "$NULL_TOKEN" ]] && break; sleep 1; done
      stack_post "$URL/api/view/attach" "{\"token_file\":\"$NULL_TOKEN\"}" >/dev/null || true
      rc=0; wait "$CPID" || rc=$?   # a crash must not end the loop under set -e (see the GUI loop)
      echo "client exited with $rc; restarting in 3 s" >> "$TMP/null-client.log"
      rm -f "$NULL_TOKEN"
      sleep 3
    done
  ) &
  GUI_PID=$!
fi

# The lineup of a new world (--lineup): every other company's AI, started after the bot's own
# company exists, so the bot keeps the first company. A loaded game keeps the AIs it saved.
if [[ -n "$LINEUP" && ${#LOAD[@]} -eq 0 ]]; then
  for ((i = 0; i < 300; i++)); do curl -s "$URL/api/bots" | jq -e '.running | length >= 1' >/dev/null 2>&1 && break; sleep 1; done
  IFS=',' read -r -a LINEUP_AIS <<<"$LINEUP"
  for ai in "${LINEUP_AIS[@]}"; do
    ai="$(sed -E 's/^ +| +$//g' <<<"$ai")"
    [[ -n "$ai" ]] || continue
    before="$(curl -s "$URL/api/bots" | jq '.running | length' 2>/dev/null || echo 0)"
    stack_post "$URL/api/console" "$(jq -nc --arg c "start_ai \"$ai\"" '{command:$c}')" >/dev/null || true
    started=0
    for ((j = 0; j < 30; j++)); do
      now="$(curl -s "$URL/api/bots" | jq '.running | length' 2>/dev/null || echo 0)"
      if [[ "$now" -gt "$before" ]]; then started=1; break; fi
      sleep 1
    done
    if [[ "$started" == 1 ]]; then echo "==> lineup: $ai started"; else echo "mcp-e2e: lineup: $ai did not start (not installed? list_ai)" >&2; fi
  done
fi

# The services a co-play game runs (research/coplay.md "Services"): the arena fills the other
# companies (unless --lineup names them), replan re-plans the bot every game month, and the
# monitors watch every company without changing the game: the watchdog (a stall and why), the build
# audit, the rail monitor (advice from the game's news) and the capital watch (money not put back
# to work). With --lineup or --load the owner's company is the only PrismaticAI one, so the
# leader-gap watch runs there too; in an arena the other PrismaticAI companies are rivals', and
# gap_watch tells and proposes only for the owner's company once #319 is on master. Started here,
# never by hand; MCP_SERVICES names another list (empty: none).
MONITORS="watchdog build_audit rail_monitor capital_watch"
DEFAULT_SERVICES="arena replan $MONITORS"
[[ -n "$LINEUP" || ${#LOAD[@]} -gt 0 ]] && DEFAULT_SERVICES="replan $MONITORS gap_watch"
if [[ "$COPLAY" == 1 ]]; then
  for svc in ${MCP_SERVICES-$DEFAULT_SERVICES}; do
    out="$(stack_post "$URL/api/services/start" "{\"name\":\"$svc\"}" || true)"
    if grep -q '"running": true' <<<"$out"; then echo "==> service $svc started"; else echo "mcp-e2e: service $svc did not start: ${out:-no answer}" >&2; fi
  done
fi

echo "==> running. Ctrl-C stops everything."
wait "$PANEL_PID"
