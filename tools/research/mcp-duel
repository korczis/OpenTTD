#!/usr/bin/env bash
# RESEARCH-ONLY: a duel in one game. Two companies on the same map compete for the same towns and
# industries: company A is the owner's bot started from the planner's portfolio (the panel does it),
# company B another AI: by default the same bot started without a plan, or any installed AI named with
# --opponent (e.g. AdmiralAI or SimpleAI from BaNaNaS, downloaded with the console's content commands). Every game month both are read from the console's
# `companies` command; after N months the one with the higher company value wins. The record goes to
# research/results/duel-<time>-seed<N>.{json,md} with both bots' logs.
#
# Company B runs its own defaults at the revision that runs. Since df1e05e7d8 PrismaticAI's default is
# autopilot=1: without a plan it grows on its own (in-bot steward, own freight lines). A default duel
# since then measures the plan against that autopilot. Every record before it measured the plan
# against the bot without a plan as it was, which built buses and no rail. To start that former rival
# again, give its settings after the name (start_ai takes them): --opponent 'PrismaticAI autopilot=0'.
# B's live settings are read from GET /api/bots before the first month and kept as `rival`; the
# rival's spread groups records by them, so the autopilot and the former rival are never mixed.
# The AI is loaded from the game's personal ai/ folder, which tools/research/prismatic-ai/install links
# to a live checkout; a run that must not change under it uses a copy (research/duel-evidence-audit.md).
#
# What the record holds is read from the panel's DuckDB store (ADR 0033, ADR 0034, issue I0083) by
# query on /api/db/query, paged so that no read is cut: the plan from the run's plan.* events (and its
# `planner:` sentences for reading), the AI logs from its ai.log rows, the months from its samples
# (the first sampled day of each game month), the held start's tick from game.paused/game.resumed.
# The record names the store file, the instance, the run and every query, so it can be re-read after
# the panel stopped. The verdict goes back on the bus as plan.duel (POST /api/bus/publish), and so
# into the store. Without a store the duel reads as before (the newest 200 panel sentences of
# /api/status, at most 5000 bus events, the console's months) and the record says why (`fallback`).
#
# Every record's page carries charts (company value and fleet per month, A against B) between
# `<!-- duel-charts:begin -->` and `<!-- duel-charts:end -->`, derived from its JSON alone. `--render`
# rewrites that region in every tracked research/results/duel-*.md (inserting it above the month table
# of a page written before the charts) and starts no game; `--render --check` writes nothing and exits
# 11 while a page is stale. `tools/surfaces/surfaces sync` runs the first, `surfaces check` the second
# (surfaces.toml, generator duel-charts), so a change of the charts reaches every page in one commit.
#
# Battlebrain held-start pairs (research/battlebrain/experiment-freight-margin.md, Phase 06; RESEARCH-ONLY).
# Two flags make a duel one arm of such a pair. Neither one decides anything:
# - `--capture-at-start DIR` captures the held start, after company A is founded and before B is:
#   the game is still paused then. It runs mcp-plan with the panel's own planner arguments (from its
#   plan.portfolio event) plus `--capture DIR`, and writes DIR/plan.json and DIR/held-start.json.
#   `battlebrain snapshot` and `battlebrain live` decide on that capture later, offline.
# - `--directive FILE` takes a `battlebrain live` answer, and its directive's settings become A's
#   extra settings, verbatim. The flag refuses a shadow answer, a HOLD, and a directive that leaves
#   any other fr*_from slot to the planner. It cannot be combined with --bot-settings.
# `pair-check A_LIVE B_LIVE` (no game) says whether both arms' captures led to the same decision.
#
# Usage: tools/research/mcp-duel [--months 24] [--seed N] [--label text] [--opponent AI]
#                               [--bot-settings k=v,... | --directive FILE] [--capture-at-start DIR]
#        tools/research/mcp-duel --render [--check]
#        tools/research/mcp-duel pair-check <arm P live.json> <arm BB live.json>
# Exit: 0 the duel completed (whoever won), the pages are current or the pair's decisions agree,
# 1 the stack did not come up, the capture failed or the pair's decisions differ, 2 bad arguments,
# 11 (--render --check) a page's charts are stale.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MONTHS=24 SEED="$RANDOM" LABEL="" OPPONENT="PrismaticAI" BOT_SETTINGS="" RENDER="" CHECK="" CAPTURE="" DIRECTIVE=""
# One function of the duel's Python (the heredoc below, as test_mcp_duel.py loads it), run on its own:
# `duel_py <name> <args...>` calls cli_<name>(root, *args) and exits with what it returns.
duel_py() {
  python3 -I - "$ROOT_DIR" "$@" <<'CALL'
import re
import sys
import types
from pathlib import Path

root = Path(sys.argv[1])
script = root / "tools" / "research" / "mcp-duel"
mod = types.ModuleType("mcp_duel")
exec(compile(re.search(r"<<'PY'\n(.*?)\nPY\n", script.read_text(), re.S)[1], f"{script} (heredoc)", "exec"), mod.__dict__)
sys.exit(getattr(mod, "cli_" + sys.argv[2].replace("-", "_"))(root, *sys.argv[3:]))
CALL
}
if [[ "${1:-}" == "pair-check" ]]; then
  [[ $# -eq 3 ]] || { echo "usage: mcp-duel pair-check <arm P live.json> <arm BB live.json>" >&2; exit 2; }
  duel_py pair-check "$2" "$3"
  exit $?
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --months) MONTHS="${2:?}"; shift 2 ;;
    --seed) SEED="${2:?}"; shift 2 ;;
    --label) LABEL="${2:?}"; shift 2 ;;
    --opponent) OPPONENT="${2:?}"; shift 2 ;;
    --bot-settings) BOT_SETTINGS="${2:?}"; shift 2 ;;
    --capture-at-start) CAPTURE="${2:?}"; shift 2 ;;
    --directive) DIRECTIVE="${2:?}"; shift 2 ;;
    --render) RENDER=1; shift ;;
    --check) CHECK=1; shift ;;
    -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "usage: mcp-duel [--months N] [--seed N] [--label text] [--opponent AI] [--bot-settings k=v,... | --directive FILE] [--capture-at-start DIR] | --render [--check] | pair-check A B" >&2; exit 2 ;;
  esac
done
if [[ -n "$CHECK" && -z "$RENDER" ]]; then
  echo "mcp-duel: --check goes with --render" >&2; exit 2
fi
if [[ -n "$DIRECTIVE" ]]; then
  if [[ -n "$BOT_SETTINGS" ]]; then
    echo "mcp-duel: --directive and --bot-settings exclude each other (the directive is the arm's only settings)" >&2; exit 2
  fi
  BOT_SETTINGS="$(duel_py directive-settings "$DIRECTIVE")" || exit 2
fi
if [[ -n "$CAPTURE" && "${PRISMATIC_START_PAUSED:-2}" -lt 2 ]]; then
  echo "mcp-duel: --capture-at-start needs the held start (PRISMATIC_START_PAUSED >= 2): the game must still be paused after A is founded" >&2; exit 2
fi
export DUEL_CAPTURE_DIR="$CAPTURE" DUEL_DIRECTIVE="$DIRECTIVE"
if [[ -n "$RENDER" ]]; then
  # The duel's own Python (the heredoc below, as test_mcp_duel.py loads it), run for its pages only:
  # no stack, no game, nothing but research/results read and (without --check) its pages written.
  exec python3 -I - "$ROOT_DIR" "$CHECK" <<'RENDER'
import re
import sys
import types
from pathlib import Path

root = Path(sys.argv[1])
script = root / "tools" / "research" / "mcp-duel"
mod = types.ModuleType("mcp_duel")
exec(compile(re.search(r"<<'PY'\n(.*?)\nPY\n", script.read_text(), re.S)[1], f"{script} (heredoc)", "exec"), mod.__dict__)
sys.exit(mod.render_pages(root, check=bool(sys.argv[2])))
RENDER
fi
free() { python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
PANEL="$(free)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-duel.XXXXXX")"
PID=""
cleanup() { [[ -n "$PID" ]] && kill -TERM "$PID" 2>/dev/null; wait 2>/dev/null || true; }
trap cleanup EXIT INT TERM

# Extra settings for the planned bot only (company A), on top of what the panel derives from the plan,
# e.g. own_lines=8: an A/B of a bot feature without a code change. The panel reads them at bot start.
export PRISMATIC_BOT_SETTINGS="$BOT_SETTINGS"
# A held start (knowledge duels-run-side-by-side-are-noisy): the panel keeps the game paused until
# both AI companies exist, so two runs of one seed start from the same state. 0 starts unpaused.
export PRISMATIC_START_PAUSED="${PRISMATIC_START_PAUSED:-2}"
# No background strategist (research/mechanisms/strategist-and-blackboard.md): its MCP reads and
# console line would change a measured run's timing. A caller's own value wins.
export PRISMATIC_STRATEGIST="${PRISMATIC_STRATEGIST:-0}"
echo "==> duel on :$PANEL, seed $SEED, $MONTHS months, held start $PRISMATIC_START_PAUSED${BOT_SETTINGS:+, bot settings $BOT_SETTINGS}"
# The stack's run token (mcp-e2e make_run_token): in a 0600 file of this run, so this script's own
# console lines are the stack's, like its helpers'.
export MCP_E2E_RUN_TOKEN_FILE="$TMP/run-token"
"$ROOT_DIR/tools/research/mcp-e2e" --no-gui --no-browser --seed "$SEED" --panel-port "$PANEL" \
  --mcp-port "$(free)" --game-port "$(free)" > "$TMP/stack.log" 2>&1 &
PID=$!
for ((i = 0; i < 240; i++)); do
  curl -s "http://127.0.0.1:$PANEL/api/status" 2>/dev/null | grep -q '"ai_started": true' && break
  sleep 2
done
curl -s "http://127.0.0.1:$PANEL/api/status" | grep -q '"ai_started": true' || { echo "mcp-duel: the stack did not come up ($TMP)" >&2; exit 1; }

# A is founded and B is not, so the held game is still paused: capture its start (Battlebrain pairs).
if [[ -n "$CAPTURE" ]]; then
  echo "==> capturing the held start into $CAPTURE (mcp-plan with the panel's planner arguments)"
  duel_py capture-at-start "$PANEL" "$CAPTURE" || { echo "mcp-duel: the held start was not captured ($CAPTURE)" >&2; exit 1; }
fi

# Company B: the opponent AI with its own defaults (start_ai with no settings starts a new AI
# company). An AI the game does not have is refused here, before any month is played.
out="$(printf 'X-Panel-Token: %s\n' "$(tr -d '[:space:]' < "$MCP_E2E_RUN_TOKEN_FILE")" \
  | curl -s -X POST -H @- -H 'Content-Type: application/json' -d "{\"command\":\"start_ai $OPPONENT\",\"wait\":2.0}" \
    "http://127.0.0.1:$PANEL/api/console")"
# The game's own refusal (console_cmds.cpp ConStartAI); the bot's log lines may say "failed" too.
if grep -q "Failed to load the specified AI" <<<"$out"; then
  echo "mcp-duel: the game has no AI named $OPPONENT: $out" >&2; exit 2
fi

# The Python below is also loaded, from this heredoc, by tools/research/test_mcp_duel.py, which runs it
# offline against a fake panel: everything is a function, and the duel runs under __main__ only.
python3 -I - "$PANEL" "$MONTHS" "$SEED" "$LABEL" "$ROOT_DIR" "$OPPONENT" "$BOT_SETTINGS" <<'PY'
import json
import math
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROW = re.compile(r"#:(\d+)\(.*?\)\s+Company Name: '([^']*)'\s+Year Founded: (\d+)\s+Money: (-?\d+)\s+Loan: (\d+)\s+Value: (-?\d+)\s+\(T:(\d+), R:(\d+), P:(\d+), S:(\d+)\)")
# The most rows one /api/db/query answers (QUERY_CAP in tools/research/mcp-rhai/src/bus_sinks.rs).
# Every store read pages by it, so a long duel's AI log is never cut there.
PAGE = 5000
# Seconds between two reads of the game clock.
POLL = 20
# The verdict's kind, declared external in tools/research/mcp-rhai/src/panel_events.rs KINDS.
VERDICT = "plan.duel"


def error_text(e):
    """The panel's {"error": ...} of an HTTP error, else its reason."""
    try:
        return str(json.loads(e.read()).get("error") or e.reason)
    except (ValueError, AttributeError, OSError):
        return str(getattr(e, "reason", e))


class Panel:
    """The panel's HTTP API on 127.0.0.1:<port>."""

    def __init__(self, port, sleep=time.sleep):
        self.port = int(port)
        self.base = f"http://127.0.0.1:{self.port}"
        self.sleep = sleep

    def patient(self, open_, settled=(), tries=6):
        # A busy game can make one read fail (a 502 from the panel, a timeout). Every read here (state,
        # events, the console's `companies`, the store) is tried again; one failed read lost a whole
        # 36-month run at month 15 (2026-11-17). A status in `settled` is an answer, not a failure
        # (503 from /api/db/query: the store is off).
        for attempt in range(tries):
            try:
                with open_() as r:
                    return json.loads(r.read())
            except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError) as e:
                if isinstance(e, urllib.error.HTTPError) and (e.code < 500 or e.code in settled) or attempt == tries - 1:
                    raise
                print(f"mcp-duel: a read failed ({e}); trying again", file=sys.stderr)
                self.sleep(3)

    def post(self, path, body, settled=(), tries=6):
        data = json.dumps(body).encode()
        req = lambda: urllib.request.Request(self.base + path, data=data, headers={"Content-Type": "application/json"}, method="POST")
        return self.patient(lambda: urllib.request.urlopen(req(), timeout=30), settled, tries)

    def get(self, path, settled=()):
        return self.patient(lambda: urllib.request.urlopen(self.base + path, timeout=30), settled)


def companies(panel):
    """The console's `companies`, keyed by its company number ("1" is company index 0)."""
    out = panel.post("/api/console", {"command": "companies", "wait": 1.0}).get("output", [])
    text = " ".join(l if isinstance(l, str) else str(l) for l in out)
    return {m[0]: {"name": m[1], "money": int(m[3]), "loan": int(m[4]), "value": int(m[5]),
                   "trains": int(m[6]), "road": int(m[7]), "planes": int(m[8])} for m in ROW.findall(text)}


def month_index(date):
    """A game date's month as a running count (year * 12 + month - 1); None for no date."""
    m = re.match(r"(\d{4})-(\d{2})", str(date or ""))
    return int(m[1]) * 12 + int(m[2]) - 1 if m else None


def month_text(index):
    return f"{index // 12:04d}-{index % 12 + 1:02d}"


def game_date(panel):
    return panel.get("/api/resources/game/state").get("game_date")


def months_seen(panel):
    """The game month as a running count, from the game's own date. Counting game.month events
    undercounted: the panel's event buffer is capped and drops the oldest, so a 120-month duel's
    month 72 was dated 29 months after its month 60 (2026-11-16)."""
    return month_index(game_date(panel)) or 0


# ---------------------------------------------------------------------- the store (ADR 0033)

class StoreOff(Exception):
    """No store to read; the message is the fallback the record and the plan.duel event name."""


def valid_instance(name):
    """An instance name as the registry writes it (letters, digits, `-`, `_`, `.`), so it can stand
    in a quoted literal of a read-only statement."""
    return bool(name) and len(name) <= 64 and all(c.isascii() and (c.isalnum() or c in "-_.") for c in name)


def rows_of(answer):
    """The rows of a /api/db/query answer {columns, rows, count, capped} as dicts by column name."""
    cols = answer.get("columns") or []
    return [dict(zip(cols, r)) for r in answer.get("rows") or []]


class Store:
    """This duel's run in the panel's store: the file, the instance, its `runs` row, and the window
    [started_ms, until_ms] every read is bound to, so the record's queries read the same rows again
    from the file after the panel stopped."""

    def __init__(self, panel, file, instance, run=None):
        self.panel, self.file, self.instance, self.run = panel, file, instance, run
        self.until_ms = None
        self.queries = {}

    @classmethod
    def find(cls, panel):
        """The store and the newest run on this panel's port; StoreOff with the reason otherwise."""
        try:
            bus = panel.get("/api/bus", settled=(503,))
        except urllib.error.HTTPError as e:
            raise StoreOff(f"GET /api/bus answered {e.code} ({error_text(e)}): no bus tap (ADR 0033) on this panel")
        except (urllib.error.URLError, TimeoutError) as e:
            raise StoreOff(f"GET /api/bus failed: {e}")
        file, instance = bus.get("store"), str(bus.get("instance") or "")
        if not file or file == "off":
            raise StoreOff("GET /api/bus answers store: off (a panel built without the store feature, or its file did not open)")
        if not valid_instance(instance):
            raise StoreOff(f"GET /api/bus names no instance the store can be queried by ({instance!r})")
        store = cls(panel, file, instance)
        rows = store.query("SELECT instance, session, seed, started_ms, panel_port, mcp_port, game_port FROM runs "
                           f"WHERE instance = '{instance}' AND panel_port = {panel.port} ORDER BY started_ms DESC LIMIT 1")
        if not rows:
            raise StoreOff(f"the store {file} has no run of {instance} on panel port {panel.port}")
        store.run = rows[0]
        return store

    def query(self, sql):
        try:
            answer = self.panel.post("/api/db/query", {"sql": sql}, settled=(503,))
        except urllib.error.HTTPError as e:
            raise StoreOff(f"POST /api/db/query answered {e.code}: {error_text(e)}")
        except (urllib.error.URLError, TimeoutError) as e:
            raise StoreOff(f"POST /api/db/query failed: {e}")
        if answer.get("error"):
            raise StoreOff(f"POST /api/db/query: {answer['error']}")
        return rows_of(answer)

    def run_filter(self):
        """The rows of this run: a file keeps every run of its instance and seq restarts with each
        panel start, so the run is told by ts_ms (research/mcp-control.md)."""
        until = self.until_ms if self.until_ms is not None else 9223372036854775807
        return f"instance = '{self.instance}' AND ts_ms BETWEEN {int(self.run['started_ms'])} AND {int(until)}"

    def query_all(self, name, inner, order):
        """Every row of `inner`, in pages of PAGE rows in `order` (which must be a total order), and
        the statement recorded under `name` with its row count."""
        out, pages = [], 0
        while True:
            page = self.query(f"SELECT * FROM ({inner}) AS q ORDER BY {order} LIMIT {PAGE} OFFSET {len(out)}")
            pages += 1
            out += page
            if len(page) < PAGE:
                break
        self.queries[name] = {"sql": f"{inner} ORDER BY {order}", "rows": len(out), "pages": pages}
        return out

    def close_window(self):
        """Bind every later read to what the store holds now: the newest ts_ms of the run."""
        rows = self.query(f"SELECT max(ts_ms) AS until_ms FROM events WHERE {self.run_filter()}")
        newest = rows[0].get("until_ms") if rows else None
        self.until_ms = int(newest) if newest is not None else int(self.run["started_ms"])

    def has_month(self, index):
        rows = self.query(f"SELECT count(*) AS n FROM samples WHERE {self.run_filter()} AND substr(game_date, 1, 7) = '{month_text(index)}'")
        return bool(rows and rows[0].get("n"))

    def plan_events(self):
        """The run's planning decisions as data (ADR 0034 point 3), the duel's own verdict excepted."""
        rows = self.query_all("plan", "SELECT seq, kind, ts_ms, game_tick, game_date, CAST(data AS VARCHAR) AS data FROM events "
                                      f"WHERE {self.run_filter()} AND kind LIKE 'plan.%' AND kind <> '{VERDICT}'", "seq")
        return [dict(r, data=json.loads(r["data"]) if isinstance(r.get("data"), str) else r.get("data")) for r in rows]

    def plan_lines(self):
        """The `planner:` sentences of the run, newest first as /api/status listed them: prose for the
        reader of the record and the panel's result page, never what a decision reads."""
        rows = self.query_all("plan_lines", "SELECT seq, data->>'text' AS text FROM events "
                                            f"WHERE {self.run_filter()} AND kind = 'panel.ai' AND starts_with(data->>'text', 'planner')",
                              "seq DESC")
        return [r["text"] for r in rows]

    def ai_log(self):
        """Every ai.log row of the run in bus order, by company index."""
        rows = self.query_all("ai_log", "SELECT seq, data->>'company' AS company, data->>'text' AS text FROM events "
                                        f"WHERE {self.run_filter()} AND kind = 'ai.log'", "seq")
        logs = {}
        for r in rows:
            logs.setdefault(str(r["company"]), []).append(r["text"])
        return logs

    def held_rows(self):
        return self.query_all("held_start", "SELECT seq, kind, game_tick FROM events "
                                            f"WHERE {self.run_filter()} AND kind IN ('game.paused', 'game.resumed', 'plan.bot_settings')",
                              "seq")

    def samples(self):
        """Every company of the first sampled day of each game month of the run."""
        return self.query_all("samples", "SELECT company, name, game_tick, game_date, money, loan, value, net, vehicles FROM samples "
                                         f"WHERE {self.run_filter()} AND company IS NOT NULL AND game_date IS NOT NULL "
                                         "QUALIFY dense_rank() OVER (PARTITION BY substr(game_date, 1, 7) ORDER BY game_tick) = 1",
                              "game_tick, company")

    def record(self):
        return {"file": self.file, "instance": self.instance, "run": self.run,
                "window_ms": [int(self.run["started_ms"]), self.until_ms], "queries": self.queries}


# ---------------------------------------------------------------------- reading the duel

def held_start(rows, start_paused):
    """The tick a held start ran from (PRISMATIC_START_PAUSED > 0): the tick of the game.paused that
    precedes the first game.resumed after the bot's settings were chosen (the hold pauses before the
    planner runs and resumes once the AI companies exist; the tick stands still while paused, so the
    paused read is exact where the resumed one is up to a watch interval late). Rows are
    {seq, kind, game_tick} in bus order; None when the start was not held or nothing was seen."""
    if not start_paused:
        return None
    after = next((r["seq"] for r in rows if r["kind"] == "plan.bot_settings"), None)
    paused = None
    for r in rows:
        if r["kind"] == "game.paused":
            paused = r
        elif r["kind"] == "game.resumed" and (after is None or r["seq"] > after):
            return {"tick": (paused or r).get("game_tick"), "paused_seq": paused["seq"] if paused else None,
                    "resumed_seq": r["seq"], "resumed_tick": r.get("game_tick")}
    return None


def series_from_samples(samples, start, months, console):
    """Month k of the duel (1..months) is the first sampled day of game month start + k: every company
    of that day, keyed by its console number (sample company index + 1), with the console's fleet
    split of the same month (trains, road, planes; the store has the total only). A month the store
    has no sample of is listed as missing and taken from the console reading, if there is one."""
    by_month = {}
    for r in samples:
        by_month.setdefault(month_index(r["game_date"]), []).append(r)
    series, missing = [], []
    for k in range(1, months + 1):
        rows = by_month.get(start + k)
        live = console.get(k) or {}
        if not rows:
            missing.append(k)
            if live:
                series.append(dict(live, source="console"))
            continue
        split = live.get("companies") or {}
        cs = {}
        for r in sorted(rows, key=lambda r: int(r["company"])):
            key = str(int(r["company"]) + 1)
            fleet = split.get(key) or {}
            cs[key] = {"name": r["name"], "money": int(r["money"]), "loan": int(r["loan"]), "value": int(r["value"]),
                       "net": int(r["net"]), "vehicles": r["vehicles"],
                       "trains": fleet.get("trains"), "road": fleet.get("road"), "planes": fleet.get("planes")}
        series.append({"month": k, "date": rows[0]["game_date"], "tick": rows[0]["game_tick"], "companies": cs,
                       "console_date": live.get("date")})
    return series, missing


def read_store(store, start, months, console, start_paused, wait=15, sleep=time.sleep):
    """Everything the record reads from the store, once the duel's months are played: first wait
    until the last month's sample is committed, then close the window and read."""
    for _ in range(wait):
        if store.has_month(start + months):
            break
        sleep(1)
    store.close_window()
    plan_events = store.plan_events()
    series, missing = series_from_samples(store.samples(), start, months, console)
    return {"plan": store.plan_lines(), "plan_events": plan_events, "bot_log": store.ai_log(), "series": series,
            "missing_months": missing, "held": held_start(store.held_rows(), start_paused)}


def read_fallback(panel, status_plan, console, start_paused):
    """Today's reads, for a panel without a store: the plan sentences read at the start from the 200
    of /api/status, the newest 5000 bus events, the console's months."""
    logs = {}
    for e in panel.get("/api/events?since=0&kinds=ai.log&limit=5000").get("events", []):
        logs.setdefault(str(e["data"]["company"]), []).append(e["data"]["text"])
    rows = [{"seq": e["seq"], "kind": e["kind"], "game_tick": (e.get("data") or {}).get("tick")}
            for e in panel.get("/api/events?since=0&kinds=game.paused,game.resumed,plan.bot_settings&limit=5000").get("events", [])]
    held = held_start(rows, start_paused)
    if held is None and start_paused:
        m = next((re.search(r"game unpaused at tick (\d+)", p) for p in status_plan if "game unpaused at tick" in p), None)
        held = {"tick": int(m[1]), "from": "the planner sentence of /api/status"} if m else None
    return {"plan": status_plan, "plan_events": [], "bot_log": logs, "series": [console[k] for k in sorted(console)],
            "missing_months": [], "held": held, "bot_log_capped": sum(len(v) for v in logs.values()) >= 5000}


# ---------------------------------------------------------------------- the verdict

def winner_of(a, b, b_name):
    if a.get("value", 0) > b.get("value", 0):
        return "A (planned)"
    return f"B ({b_name})" if b.get("value", 0) > a.get("value", 0) else "tie"


def was_held(rec):
    """Did a recorded duel start held? Its held_start_tick (from I0083 on), or, for older records, the
    planner sentence the panel wrote when it unpaused."""
    if rec.get("held_start_tick") is not None:
        return True
    return any(isinstance(p, str) and "game unpaused at tick" in p for p in rec.get("plan") or [])


def rival_config(panel):
    """Company B's AI and live settings ({name: value}) from GET /api/bots, where company id 1 is the
    console's #2; None when the panel cannot say (an older panel, B not running yet). The opponent's
    name alone does not say which rival ran: since df1e05e7d8 `PrismaticAI` with its defaults grows
    on autopilot, where every earlier record's B built buses."""
    try:
        running = panel.get("/api/bots").get("running") or []
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, ValueError, AttributeError):
        return None
    for r in running:
        if r.get("id") == 1 and isinstance(r.get("settings"), list):
            return {"ai": r.get("ai"), "settings": {s["name"]: s.get("value") for s in r["settings"] if "name" in s},
                    "from": "GET /api/bots, company id 1, before the first month"}
    return None


def rival_settings(rec):
    return (rec.get("rival") or {}).get("settings")


def rival_spread(results, seed, months, opponent, held, b_value, name, settings=None):
    """The spread of the rival's final value (B) over the recorded duels of this seed, length,
    opponent, start (held or not) and rival settings, this one included: (max - min) / min. ADR 0034
    point 6 reads a pair against it; null with fewer than two runs. A run whose rival settings are
    known groups only with records that hold the same settings; a run without them only with records
    without them, as before."""
    runs = []
    for path in (sorted(results.glob("duel-*.json")) if results.is_dir() else []):
        if path.stem == name:
            continue
        try:
            rec = json.loads(path.read_text())
            if (rec.get("seed"), rec.get("months"), rec.get("opponent", "PrismaticAI")) != (seed, months, opponent) or was_held(rec) != held:
                continue
            if rival_settings(rec) != settings:
                continue
            runs.append((path.stem, int(rec["final"]["2"]["value"])))
        except (ValueError, KeyError, TypeError, OSError):
            continue
    if b_value is not None:
        runs.append((name, int(b_value)))
    values = [v for _, v in runs]
    spread = round((max(values) - min(values)) / min(values), 4) if len(values) >= 2 and min(values) > 0 else None
    return {"spread": spread, "runs": len(values), "min": min(values) if values else None, "max": max(values) if values else None,
            "of": "B's final company value over the recorded duels of this seed, months, opponent, start and rival settings, this one included",
            "rival_settings": "recorded" if settings is not None else "not recorded",
            "records": [n for n, _ in runs]}


def fnv1a64(params):
    """panel_events.rs digest: FNV-1a 64 of the parameters' compact JSON with sorted keys, so equal
    parameters give the digest the panel's own plan.* events would."""
    h = 0xcbf29ce484222325
    for byte in json.dumps(params, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode():
        h ^= byte
        h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
    return f"fnv1a64:{h:016x}"


def revision(root):
    """Git's short HEAD, `-dirty` when this script had uncommitted changes (as build.rs names the
    panel's revision)."""
    try:
        git = lambda *a: subprocess.run(["git", "-C", root, *a], capture_output=True, text=True, check=True).stdout.strip()
        return git("rev-parse", "--short=10", "HEAD") + ("-dirty" if git("status", "--porcelain", "--", "tools/research/mcp-duel") else "")
    except (OSError, subprocess.CalledProcessError):
        return "unknown"


def side(c, number):
    return {"company": number, "name": c.get("name"), "value": c.get("value"), "money": c.get("money"), "loan": c.get("loan")}


def verdict_payload(cfg, rev, held, a, b, rival, winner, store, fallback, record, panel_base, rival_settings=None):
    """The data of plan.duel: {decision, version, inputs, choice} (panel_events.rs plan), with the
    verdict {seed, months, held_start_tick, a, b, rival_spread, rival} (and the winner) as its choice:
    `rival` is B's live settings ({name: value}, None when unread), so a reader of stored verdicts
    (duel_outcomes.rs) groups duels by the rival that ran, not by the opponent's name."""
    params = {"months": cfg["months"], "opponent": cfg["opponent"], "bot_settings": cfg["bot_settings"],
              "start_paused": cfg["start_paused"], "page": PAGE}
    live = {"panel": panel_base, "clock": "GET /api/resources/game/state (game_date)",
            "fleet": "POST /api/console companies (trains, road, planes per month)", "record": record}
    if store is not None:
        stored = {"query": {n: q["sql"] for n, q in store.queries.items()}, "rows": sum(q["rows"] for q in store.queries.values()),
                  "by_query": {n: q["rows"] for n, q in store.queries.items()}, "file": store.file, "instance": store.instance,
                  "run_started_ms": store.run["started_ms"], "window_ms": [int(store.run["started_ms"]), store.until_ms]}
    else:
        stored = {"fallback": fallback}
    choice = {"seed": cfg["seed"], "months": cfg["months"], "held_start_tick": held, "a": side(a, 1), "b": side(b, 2),
              "rival_spread": rival, "rival": rival_settings, "winner": winner}
    return {"decision": "duel.verdict", "version": {"revision": rev, "params": params, "digest": fnv1a64(params)},
            "inputs": {"live": live, "stored": stored}, "choice": choice}


def publish_verdict(panel, store, payload, wait=10, sleep=time.sleep):
    """POST /api/bus/publish {kind: plan.duel, data} once (a publish is not a read, so it is not tried
    again), then find it in the store. What happened, for the record."""
    out = {"kind": VERDICT, "seq": None, "stored": False}
    try:
        out["seq"] = panel.post("/api/bus/publish", {"kind": VERDICT, "data": payload}, tries=1).get("seq")
    except urllib.error.HTTPError as e:
        out["error"] = f"POST /api/bus/publish answered {e.code}: {error_text(e)}"
        return out
    except (urllib.error.URLError, TimeoutError) as e:
        out["error"] = f"POST /api/bus/publish failed: {e}"
        return out
    if store is None or out["seq"] is None:
        return out
    sql = (f"SELECT seq FROM events WHERE instance = '{store.instance}' AND ts_ms >= {int(store.run['started_ms'])} "
           f"AND kind = '{VERDICT}' AND seq = {int(out['seq'])}")
    out["query"] = sql
    for _ in range(wait):
        try:
            if store.query(sql):
                out["stored"] = True
                return out
        except StoreOff as e:
            out["error"] = f"not found in the store: {e}"
            return out
        sleep(1)
    out["error"] = f"not in the store {wait} s after the publish"
    return out


def claim_name(results, seed, clock=lambda: time.strftime("%Y%m%dT%H%M%S"), sleep=time.sleep):
    """A record name no other duel holds, duel-<time>-seed<N>, claimed by creating its .json
    exclusively. The two halves of a pair run side by side and can end in the same second: on
    2026-11-18 both took duel-20261118T102030-seed31337 and the later one overwrote the other's
    record. A taken name waits for the next second."""
    results.mkdir(parents=True, exist_ok=True)
    while True:
        name = f"duel-{clock()}-seed{seed}"
        try:
            os.close(os.open(results / f"{name}.json", os.O_CREAT | os.O_EXCL | os.O_WRONLY))
            return name
        except FileExistsError:
            sleep(1)


# ---------------------------------------------------------------------- the duel

def duel(panel, cfg, poll=POLL, sleep=time.sleep):
    """Play the duel's months, read what the run recorded, publish the verdict; the record."""
    try:
        store, fallback = Store.find(panel), None
        print(f"mcp-duel: store {store.file}, instance {store.instance}, run started at {store.run['started_ms']} ms", flush=True)
    except StoreOff as e:
        store, fallback = None, str(e)
        print(f"mcp-duel: no store, reading as before I0083: {fallback}", file=sys.stderr, flush=True)
    # Today's read of the plan, kept for the fallback: the newest 200 panel sentences, read now,
    # before the duel's months push them out.
    status_plan = [e["text"] for e in panel.get("/api/status")["events"] if e["kind"] == "ai" and e["text"].startswith("planner")]
    rival = rival_config(panel)
    start = months_seen(panel)
    seen, console = start, {}
    while seen - start < cfg["months"]:
        sleep(poll)
        n = months_seen(panel)
        if n > seen:
            seen = n
            snap = companies(panel)
            date = game_date(panel)
            console[n - start] = {"month": n - start, "date": date, "companies": snap}
            print(f"month {n - start:>2} {date}: " + "; ".join(f"#{k} {v['name']} value {v['value']} (T{v['trains']} R{v['road']} P{v['planes']})"
                                                       for k, v in sorted(snap.items(), key=lambda kv: int(kv[0]))), flush=True)
    reads = None
    if store is not None:
        try:
            reads = read_store(store, start, cfg["months"], console, cfg["start_paused"], sleep=sleep)
        except StoreOff as e:
            store, fallback = None, f"the store could not be read after the duel: {e}"
            print(f"mcp-duel: {fallback}; reading as before I0083", file=sys.stderr, flush=True)
    if reads is None:
        reads = read_fallback(panel, status_plan, console, cfg["start_paused"])
    series = reads["series"]
    final = series[-1]["companies"] if series else {}
    # Company #1 is the planned bot (started by the panel first), #2 the unplanned one.
    a, b = final.get("1", {}), final.get("2", {})
    b_name = "unplanned" if cfg["opponent"] == "PrismaticAI" else cfg["opponent"]
    winner = winner_of(a, b, b_name)
    held = reads["held"]["tick"] if reads["held"] else None
    results = cfg["root"] / "research" / "results"
    name = claim_name(results, cfg["seed"], sleep=sleep)
    spread = rival_spread(results, cfg["seed"], cfg["months"], cfg["opponent"], bool(cfg["start_paused"]), b.get("value"), name,
                          rival["settings"] if rival else None)
    payload = verdict_payload(cfg, revision(str(cfg["root"])), held, a, b, spread, winner, store, fallback,
                              f"research/results/{name}.json", panel.base, rival["settings"] if rival else None)
    verdict = publish_verdict(panel, store, payload, sleep=sleep)
    return {"name": name, "b_name": b_name, "record": {
        "experiment": f"duel in one game: planned bot (A, company 1) vs {b_name} (B, company 2)", "label": cfg["label"],
        "opponent": cfg["opponent"], "rival": rival, "bot_settings": cfg["bot_settings"], "seed": cfg["seed"], "months": cfg["months"],
        "start_paused": cfg["start_paused"], "held_start_tick": held, "held_start": reads["held"],
        "store": store.record() if store is not None else None, "fallback": fallback,
        "missing_months": reads["missing_months"], "bot_log_capped": reads.get("bot_log_capped", False),
        "plan": reads["plan"], "plan_events": reads["plan_events"], "final": final, "winner": winner,
        "rival_spread": spread, "verdict_event": dict(verdict, data=payload),
        "series": series, "bot_log": reads["bot_log"]}}


# ---------------------------------------------------------------------- the charts

# The charts of a page sit between these markers: tools/surfaces/surfaces check refuses a chart
# outside a generated region, and --render rewrites exactly this region of every page.
CHARTS_BEGIN, CHARTS_END = "<!-- duel-charts:begin -->", "<!-- duel-charts:end -->"
# The NoirGFX palette (tools/research/noirgfx/style.toml) the README scoreboard draws in too.
STYLE = Path("tools") / "research" / "noirgfx" / "style.toml"


def b_name_of(rec):
    """Who B is, as duel() names it: the same bot unplanned, or the opponent AI (records before
    --opponent ran the same bot)."""
    opponent = rec.get("opponent") or "PrismaticAI"
    return "unplanned" if opponent == "PrismaticAI" else opponent


def mermaid_num(v):
    """Plain digits, never an exponent (Mermaid cannot parse 1.0e+08); as tools/surfaces/surfaces.py."""
    if float(v).is_integer():
        return str(int(v))
    return f"{v:.6f}".rstrip("0").rstrip(".")


def mermaid_xy(title, labels, series, y_title, palette, links=None):
    """A Mermaid xychart-beta: a bar for the first series, a line for each further one. GitHub draws
    it; the site reads it back and draws it with ECharts, naming the series from `%% series:` and
    opening each mark's `%% links:` target (tools/surfaces/README.md "Charts")."""
    label = lambda t: str(t).replace('"', "'")
    values = [v for _, vals in series for v in vals]
    whole = all(float(v).is_integer() for v in values)  # a count's axis ends on a whole number

    def span(v):
        edge = float(f"{v * 1.1:.3g}")
        return mermaid_num((math.ceil(edge) if edge > 0 else math.floor(edge)) if whole else edge) if v else "0"
    lines = ["```mermaid", "---", "config:", "  xyChart:", "    width: 900", "    height: 360",
             "  themeVariables:", "    xyChart:", f'      plotColorPalette: "{palette}"', "---",
             "xychart-beta", f'    title "{label(title)}"', "    x-axis [" + ", ".join(f'"{label(x)}"' for x in labels) + "]",
             f"    %% series: {' | '.join(label(n) for n, _ in series)}"]
    if links:
        lines.append(f"    %% links: {' | '.join(links)}")
    lines.append(f'    y-axis "{label(y_title)}" {span(min(values + [0]))} --> {span(max(values + [1]))}')
    lines += [f"    {'bar' if i == 0 else 'line'} [{', '.join(mermaid_num(v) for v in vals)}]" for i, (_, vals) in enumerate(series)]
    return "\n".join(lines + ["```"])


def fleet(c):
    """A company's vehicles in one month: the store's total of that day, else the console's
    trains + road + planes; None when neither was read."""
    if c.get("vehicles") is not None:
        return int(c["vehicles"])
    parts = [c.get(k) for k in ("trains", "road", "planes")]
    return sum(int(x) for x in parts) if all(x is not None for x in parts) else None


def charts(rec, page=None, root=Path(".")):
    """The record's charts, every number from its series: company value per month, A against B, and
    the fleet per month when every month has it. With `page` (the page's file name) each month's mark
    opens that month's row of the page's table (?col=Month&filter=N, which the site filters)."""
    import tomllib
    pal = tomllib.loads((Path(root) / STYLE).read_text())["palette"]
    palette = f"{pal['signal']}, #8a8a8a, {pal['ink']}, {pal['paper']}"
    series, b_name = rec.get("series") or [], b_name_of(rec)
    out = [CHARTS_BEGIN, "<!-- generated by tools/research/mcp-duel from this record's JSON; "
           "`mcp-duel --render` rewrites it, `mcp-duel --render --check` fails while it is stale -->", ""]
    if not series:
        return "\n".join(out + ["No month was recorded: nothing to chart.", "", CHARTS_END])
    labels = [str(s.get("date") or "")[:7] or str(s["month"]) for s in series]
    links = [f"{page}?col=Month&filter={s['month']}" for s in series] if page else None
    company = lambda s, k: s["companies"].get(k) or {}
    names = ("A (planned)", f"B ({b_name})")
    values = [[int(company(s, k).get("value") or 0) for s in series] for k in ("1", "2")]
    out += [mermaid_xy(f"Company value per game month, seed {rec['seed']}: A (planned) vs B ({b_name})", labels,
                       list(zip(names, values)), "Company value", palette, links), ""]
    fleets = [[fleet(company(s, k)) for s in series] for k in ("1", "2")]
    if all(v is not None for f in fleets for v in f):
        out += [mermaid_xy(f"Vehicles per game month, seed {rec['seed']}: A (planned) vs B ({b_name})", labels,
                           list(zip(names, fleets)), "Vehicles", palette, links), ""]
    return "\n".join(out + [CHARTS_END])


def with_charts(text, region):
    """A page with its charts region replaced, or, on a page written before the charts, inserted
    above its month table (at the end when it has none)."""
    if CHARTS_BEGIN in text and CHARTS_END in text:
        a, b = text.index(CHARTS_BEGIN), text.index(CHARTS_END) + len(CHARTS_END)
        return text[:a] + region + text[b:]
    m = re.search(r"^\| Month \|", text, re.M)
    if m:
        return text[:m.start()] + region + "\n\n" + text[m.start():]
    return text.rstrip("\n") + "\n\n" + region + "\n"


def tracked_records(root):
    """The duel records the next commit can hold, as tools/research/readme-scoreboard records(): what
    git tracks plus new files it would not ignore; inside a git hook (GIT_INDEX_FILE) only the index;
    outside a git checkout of root every record on disk."""
    results = Path(root) / "research" / "results"
    env = dict(os.environ)
    if env.get("GIT_INDEX_FILE"):
        env["GIT_INDEX_FILE"] = os.path.abspath(env["GIT_INDEX_FILE"])
    sources = ["--cached"] + ([] if env.get("GIT_INDEX_FILE") else ["--others", "--exclude-standard"])
    git = lambda *a: subprocess.run(["git", *a], cwd=results, env=env, check=True, capture_output=True, text=True).stdout
    try:
        if Path(git("rev-parse", "--show-toplevel").strip()).resolve() != Path(root).resolve():
            raise ValueError("not a checkout of root")
        listed = git("ls-files", "-z", *sources, "--", ".").split("\0")
    except (OSError, ValueError, subprocess.CalledProcessError):
        return sorted(results.glob("duel-*.json")) if results.is_dir() else []
    return sorted(results / f for f in listed if f and "/" not in f and Path(f).match("duel-*.json") and (results / f).exists())


def render_pages(root, check=False):
    """--render: every tracked record's page with its charts derived from its JSON (the rest of the
    page, its reading of that run, is kept as written). With check, write nothing and return 11 while
    a page would change (Majordomus exit codes)."""
    stale = []
    records = tracked_records(root)
    for path in records:
        md = path.with_suffix(".md")
        if not md.is_file():
            continue
        text = md.read_text()
        new = with_charts(text, charts(json.loads(path.read_text()), md.name, root))
        if new != text:
            stale.append(md)
            if not check:
                md.write_text(new)
    rel = lambda p: p.relative_to(root).as_posix()
    if check:
        for md in stale:
            print(f"{rel(md)}: its charts are not derived from {md.with_suffix('.json').name} "
                  "(run tools/research/mcp-duel --render)", file=sys.stderr)
        return 11 if stale else 0
    print(f"mcp-duel --render: {len(stale)} of {len(records)} page(s) rewritten")
    return 0


def markdown(rec, b_name, page=None, root=Path(".")):
    """The record's reading. Its charts are charts(rec): what --render rewrites later."""
    a, b = rec["final"].get("1", {}), rec["final"].get("2", {})
    label, bot_settings, opponent = rec["label"], rec["bot_settings"], rec["opponent"]
    rows = "\n".join(f"| {s['month']} | {s['date']} | {s['companies'].get('1', {}).get('value', '')} | {s['companies'].get('2', {}).get('value', '')} |"
                     for s in rec["series"])
    v = rec["verdict_event"]
    if v.get("seq") is None:
        told = f"The verdict was not published: {v.get('error')}."
