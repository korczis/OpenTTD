#!/usr/bin/env node
// RESEARCH-ONLY. The web panel's Approve and Deny, end to end in Chrome, with no game build: a real
// mcp-panel (the Rust binary) runs against tools/research/mcp-fake-game, a stand-in dedicated
// server whose one approval queue is seeded so that every answer the panel can give is reached
// (ADR 0038: the game server decides, the panel only asks and shows):
//
//   Approve #1 -> 200 executed    the green toast says "executed succeeded"
//   Approve #2 -> 422 rejected    the red toast carries the game's reason
//   Approve #3 -> 504             consumed, but the server recorded no decision
//   Approve #4 -> 409             another channel consumed it while the page still showed it
//   Approve #5 -> 404             the server forgot it while the page still showed it
//   Deny    #6 -> 200 denied      the green toast says "denied"
//   Deny    #7 -> 504             the server never marked it denied
//   Deny    #4 -> 409, Deny #5 -> 404
//
// For #4 and #5 the page keeps the list it drew (its /api/status is held) while the server's queue
// changes under it, as a page a person left open does. Then every line of static/app.js that this
// change adds runs in the page (Chrome's own JS coverage), and the list redrawn from the server
// holds only #7.
//
// Then the owner's sign-in, in a browser that holds no cookie: the secret is in its 0600 file and
// never on the panel's stdout; switching auto-approve on opens the "Owner sign-in" box, Escape
// closes it and the switch stays off, a wrong secret is refused in the box, the right one signs in
// and the switch goes on. A reload keeps the sign-in, and so does a restart of the panel on the same
// secret file; signing out asks again. Every changed line of static/shell.js runs in these pages.
//
// e2e-covers: panel /
//
// Usage: tools/research/mcp-approval-ui-check [--panel-bin <mcp-panel>] [--base <git ref>]
//   --panel-bin  default tools/research/mcp-rhai/target/release/mcp-panel (or $MCP_PANEL_BIN)
//   --base       the ref the changed lines of app.js are counted from (default: $COVERAGE_BASE, else the
//                merge base with origin/master)
// Exit 0 when every check passes, 1 otherwise, 2 on bad usage or a missing binary. Drives Chrome through
// playwright-core (npm ci in tools/research/mcp-panel); CHROME overrides its path.
import fs from 'node:fs';
import net from 'node:net';
import path from 'node:path';
import { spawn, execFileSync } from 'node:child_process';
import { createRequire } from 'node:module';

const here = path.dirname(new URL(import.meta.url).pathname);
const repo = path.resolve(here, '../..');
const { chromium } = createRequire(path.join(here, 'mcp-panel', 'package.json'))('playwright-core');
const argv = process.argv.slice(2);
const opt = (n, d) => (argv.includes(n) ? argv[argv.indexOf(n) + 1] || d : d);
const CHROME = process.env.CHROME || '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';
const bin = opt('--panel-bin', process.env.MCP_PANEL_BIN || path.join(here, 'mcp-rhai/target/release/mcp-panel'));
if (!fs.existsSync(bin)) {
  console.error(`mcp-approval-ui-check: no mcp-panel at ${bin} (cargo build --release --bin mcp-panel in tools/research/mcp-rhai)`);
  process.exit(2);
}

const results = [];
const check = (name, ok, detail = '') => { results.push(ok); console.log(`${ok ? 'PASS' : 'FAIL'} ${name}${detail ? ` (${detail})` : ''}`); };
const freePort = () => new Promise((res) => { const s = net.createServer().listen(0, '127.0.0.1', () => { const p = s.address().port; s.close(() => res(p)); }); });
const until = async (pred, ms = 20000) => { for (let t = 0; t < ms; t += 200) { if (await pred().catch(() => false)) return true; await new Promise((r) => setTimeout(r, 200)); } return false; };

const [panelPort, mcpPort, gamePort] = [await freePort(), await freePort(), await freePort()];
const base = `http://127.0.0.1:${panelPort}`;
const store = fs.mkdtempSync(path.join(fs.realpathSync(process.env.TMPDIR || '/tmp'), 'mcp-approval-ui-'));
// The owner secret lives in a file of this run, never in the person's own ~/.config.
const secretFile = path.join(store, 'owner', 'panel-owner-secret');
let out = '';
/** One mcp-panel on this run's ports and secret file (a second call is the restart). */
const startPanel = () => {
  const child = spawn(bin, ['--bin', path.join(here, 'mcp-fake-game'), '--panel-port', String(panelPort), '--mcp-port', String(mcpPort),
    '--game-port', String(gamePort), '--no-plan-bot'], { env: { ...process.env, PRISMATIC_STORE_DIR: store, PRISMATIC_PANEL_OWNER_SECRET_FILE: secretFile }, stdio: ['ignore', 'pipe', 'pipe'] });
  child.stdout.on('data', (d) => { out += d; });
  child.stderr.on('data', (d) => { out += d; });
  return child;
};
let panel = startPanel();
const stop = () => { if (panel.exitCode === null && panel.signalCode === null) panel.kill('SIGTERM'); };
/** Stop the panel and wait until it is gone (it stops its game first); SIGKILL after 10 s. */
const stopAndWait = async () => {
  if (panel.exitCode !== null || panel.signalCode !== null) return;
  const gone = new Promise((res) => panel.once('exit', res));
  stop();
  if (await Promise.race([gone.then(() => true), new Promise((res) => setTimeout(() => res(false), 10000))])) return;
  panel.kill('SIGKILL');
  await gone;
};
/** The processes this run started that are still alive: the panel, and the stand-in it started. */
const leftovers = () => {
  try { return execFileSync('pgrep', ['-f', `(--panel-port ${panelPort} |-D 127\\.0\\.0\\.1:${gamePort} )`], { encoding: 'utf8' }).trim().split('\n').filter(Boolean); } catch (e) { if (e.status === 1) return []; throw e; }
};
process.on('exit', () => { stop(); fs.rmSync(store, { recursive: true, force: true }); });

const get = (p) => fetch(base + p).then((r) => r.json());
const post = (p, body) => fetch(base + p, { method: 'POST', headers: { 'Content-Type': 'application/json', Origin: base }, body: JSON.stringify(body) });
const queue = async () => ((await get('/api/resources/approvals')).data || {}).approvals || [];

let browser;
try {
  const named = await until(async () => out.includes(`owner secret in ${secretFile}`));
  const secret = fs.existsSync(secretFile) ? fs.readFileSync(secretFile, 'utf8').trim() : '';
  check('mcp-panel keeps its owner secret in its 0600 file and names the file', named && secret.length === 64
    && (fs.statSync(secretFile).mode & 0o777) === 0o600, secretFile);
  check('the owner secret is not on the panel\'s stdout', !!secret && !out.includes(secret));
  check('its MCP comes up with the seeded queue of 7', await until(async () => (await get('/api/status')).pending.length === 7));

  browser = await chromium.launch({ executablePath: CHROME, headless: true });
  const context = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
  const page = await context.newPage();
  const errors = [];
  page.on('pageerror', (e) => errors.push(e.message));
  await page.coverage.startJSCoverage({ resetOnNavigation: false });
  // The owner's browser signs in through a one-time link (POST /api/owner/once): it redirects to the
  // page without the query, and serves once; ?owner= redirects the same way.
  const link = await (await fetch(base + '/api/owner/once', { method: 'POST', headers: { 'Content-Type': 'application/json', Origin: base, 'X-Panel-Owner': secret }, body: '{}' })).json();
  check('the run token or nobody makes no sign-in link', (await post('/api/owner/once', {})).status === 401);
  const signedIn = await page.goto(link.url, { waitUntil: 'load' });
  check('a one-time link signs the browser in and leaves no query in the address', signedIn.ok() && page.url() === base + '/'
    && (await context.cookies()).some((c) => c.name.startsWith('mcp_owner_')), page.url());
  check('a one-time link serves once', (await fetch(link.url, { redirect: 'manual' })).status === 401);
  const bySecret = await fetch(`${base}/?owner=${encodeURIComponent(secret)}`, { redirect: 'manual' });
  check('?owner= redirects (303) to the page without the secret', bySecret.status === 303 && bySecret.headers.get('location') === '/');
  await page.goto(base + '/', { waitUntil: 'load' });
  await page.locator('#pending [data-deny="7"]').waitFor({ timeout: 15000 });
  check('each pending approval has its Approve and its Deny', (await page.locator('#pending [data-approve]').count()) === 7
    && (await page.locator('#pending [data-deny]').count()) === 7);

  // The page's list stays as drawn while the server's queue changes under it.
  let held = null;
  await page.route('**/api/status', async (route) => {
    const r = await route.fetch();
    if (!held) held = await r.json();
    await route.fulfill({ response: r, json: held });
  });
  await page.reload({ waitUntil: 'load' });
  await page.locator('#pending [data-deny="7"]').waitFor({ timeout: 15000 });
  // The stand-in's console lines change its queue, so they need the owner's authority (the console's allowlist).
  const owned = (p, body) => fetch(base + p, { method: 'POST', headers: { 'Content-Type': 'application/json', Origin: base, 'X-Panel-Owner': secret }, body: JSON.stringify(body) });
  check('a console line that changes the game is refused without a credential', (await post('/api/console', { command: 'fake consume 4' })).status === 401);
  await owned('/api/console', { command: 'fake consume 4' });
  await owned('/api/console', { command: 'fake drop 5' });
  await owned('/api/console', { command: 'fake ignore 7' });
  check('the stand-in changed its queue under the page', await until(async () => {
    const q = await queue();
    return q.some((a) => a.id === 4 && a.state === 'consumed') && !q.some((a) => a.id === 5);
  }));

  const toast = async (tone, text) => page.locator(`[data-toast="${tone}"]`).filter({ hasText: text }).first()
    .waitFor({ timeout: 15000 }).then(() => true).catch(() => false);
  const press = async (kind, id) => {
    await page.evaluate(() => document.querySelectorAll('[data-toast]').forEach((t) => t.remove()));
    await page.locator(`#pending [data-${kind}="${id}"]`).click();
  };
  for (const [kind, id, tone, text, name] of [
    ['approve', 1, 'green', '#1 approved: executed succeeded', 'Approve #1: 200, the game carried it out'],
    ['approve', 2, 'red', '/api/approve: 422', 'Approve #2: 422, the game rejected it'],
    ['approve', 3, 'red', '/api/approve: 504', 'Approve #3: 504, no decision came'],
    ['approve', 4, 'red', '/api/approve: 409 approval #4 is consumed, not pending', 'Approve #4: 409, not pending any more'],
    ['approve', 5, 'red', '/api/approve: 404 the game server holds no approval #5', 'Approve #5: 404, the server forgot it'],
    ['deny', 6, 'green', '#6 denied', 'Deny #6: 200, denied'],
    ['deny', 7, 'red', '/api/deny: 504', 'Deny #7: 504, never marked denied'],
    ['deny', 4, 'red', '/api/deny: 409 approval #4 is consumed, not pending', 'Deny #4: 409, not pending'],
    ['deny', 5, 'red', '/api/deny: 404 the game server holds no approval #5', 'Deny #5: 404, not held'],
  ]) {
    await press(kind, id);
    check(name, await toast(tone, text), text);
  }
  const q = await queue();
  const state = (id) => (q.find((a) => a.id === id) || {}).state;
  check('the server holds what the buttons did', state(1) === 'consumed' && state(2) === 'consumed' && state(6) === 'denied' && state(7) === 'pending',
    q.map((a) => `#${a.id} ${a.state}`).join(', '));
  const decided = ((await get('/api/resources/decisions')).data || {}).decisions || [];
  check('the decisions are the server\'s, recorded for #1 and #2 alone', decided.map((d) => d.approval_id).sort().join() === '1,2');

  // The list redrawn from the server's queue: only #7 still waits.
  await page.unroute('**/api/status');
  check('redrawn from the server, the list holds only #7', await until(async () => {
    const ids = await page.locator('#pending [data-approve]').evaluateAll((bs) => bs.map((b) => b.dataset.approve));
    return ids.join() === '7';
  }));
  check('the page threw no error', errors.length === 0, errors.join('; '));

  // Every line this change adds to static/app.js ran in the page (V8 block coverage, by byte).
  const covered = await page.coverage.stopJSCoverage();
  const entry = covered.find((e) => e.url.endsWith('/static/app.js'));
  const changed = changedLines('tools/research/mcp-panel/static/app.js');
  const missed = entry ? changed.filter((n) => !lineRan(entry, n)) : changed;
  check(`every changed line of static/app.js ran in Chrome (${changed.length} line(s))`, !!entry && missed.length === 0,
    missed.map((n) => `app.js:${n}`).join(', '));

  // The owner's sign-in, in a browser that holds no cookie.
  const fresh = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
  const owner = await fresh.newPage();
  owner.on('pageerror', (e) => errors.push(e.message));
  await owner.coverage.startJSCoverage({ resetOnNavigation: false });
  // V8 drops a page's coverage when it navigates away, so it is taken before every reload.
  const signed = [];
  const snapshot = async () => { signed.push(...await owner.coverage.stopJSCoverage()); await owner.coverage.startJSCoverage({ resetOnNavigation: false }); };
  const box = owner.locator('#owner-signin');
  const autoOn = async () => (await get('/api/status')).auto_approve === true;
  await owner.goto(base + '/', { waitUntil: 'load' });
  await owner.locator('#auto').waitFor({ state: 'attached', timeout: 15000 });
  await owner.locator('label:has(#auto)').click();
  check('switching auto-approve on without the secret opens the Owner sign-in box', await box.waitFor({ timeout: 10000 }).then(() => true).catch(() => false));
  check('the box names the secret\'s file', (await box.locator('code').textContent()) === secretFile);
  await owner.keyboard.press('Escape');
  check('Escape closes the box and auto-approve stays off', await until(async () => (await box.count()) === 0) && !(await autoOn()));
  check('the refusal is shown once the box is closed', await owner.locator('[data-toast="red"]').filter({ hasText: '/api/auto-approve: 401' }).first()
    .waitFor({ timeout: 10000 }).then(() => true).catch(() => false));
  await owner.locator('label:has(#auto)').click();
  await box.waitFor({ timeout: 10000 });
  await owner.locator('#owner-secret').fill('not-the-secret');
  await owner.locator('#owner-signin-form button[type="submit"]').click();
  check('a wrong secret is refused in the box', await owner.locator('#owner-signin-error').filter({ hasText: 'that is not the owner secret' })
    .waitFor({ timeout: 10000 }).then(() => true).catch(() => false) && !(await autoOn()));
  await owner.locator('#owner-secret').fill(secret);
  await owner.locator('#owner-signin-form button[type="submit"]').click();
  // autoOn() is awaited: an unawaited Promise is truthy, so the wait ended when the box closed, before
  // the sign-in's answer set the cookie read next (the check failed on master about half the time).
  check('the right secret signs in and the switch goes on', await until(async () => (await box.count()) === 0 && await autoOn()));
  const cookie = (await fresh.cookies(base)).find((c) => c.name === `mcp_owner_${panelPort}`);
  // The cookie lasts OWNER_COOKIE_MAX_AGE (mcp-rhai/src/panel.rs: 12 hours, the owner's decision of
  // 2026-11-23), so it outlives the browser session and ends within a minute of that from now.
  const maxAge = 12 * 3600;
  const left = cookie ? cookie.expires - Date.now() / 1000 : -1;
  check('the sign-in cookie is HttpOnly, SameSite=Strict and lasts the 12 hours the panel gives it', !!cookie && cookie.httpOnly && cookie.sameSite === 'Strict'
    && Math.abs(left - maxAge) < 60, cookie ? `httpOnly ${cookie.httpOnly}, sameSite ${cookie.sameSite}, ${Math.round(left)} s left` : 'no cookie');
  const toggleWithoutBox = async (want) => {
    await owner.locator('label:has(#auto)').click();
    const asked = await box.waitFor({ timeout: 2000 }).then(() => true).catch(() => false);
    if (asked) return false;
    return until(async () => (await autoOn()) === want);
  };
  check('switching off is open', await toggleWithoutBox(false));
  await snapshot();
  await owner.reload({ waitUntil: 'load' });
  await owner.locator('#auto').waitFor({ state: 'attached', timeout: 15000 });
  check('after a reload the owner is still signed in', await toggleWithoutBox(true));
  // The panel restarts on the same secret file: the browser's cookie still holds.
  await stopAndWait();
  panel = startPanel();
  check('the panel comes back after its restart', await until(async () => (await get('/api/status')).mcp_up === true, 30000));
  await snapshot();
  await owner.reload({ waitUntil: 'load' });
  await owner.locator('#auto').waitFor({ state: 'attached', timeout: 15000 });
  check('after the panel\'s restart the owner is still signed in', await toggleWithoutBox(true));
  check('the restart kept the same secret in the same file', fs.readFileSync(secretFile, 'utf8').trim() === secret && !out.includes(secret));
  check('switching off again needs no secret', await toggleWithoutBox(false));
  // raw fetch past the kit is the test's own sign-out, as a person's other tab would send it
  const logout = await owner.evaluate(async () => (await fetch('/api/owner/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })).status);
  await owner.locator('label:has(#auto)').click();
  check('after signing out the box asks again', logout === 204 && await box.waitFor({ timeout: 10000 }).then(() => true).catch(() => false));
  await owner.locator('[data-signin-cancel]').first().click();
  check('the close button closes it too', await until(async () => (await box.count()) === 0));
  signed.push(...await owner.coverage.stopJSCoverage());
  check('the sign-in pages threw no error', errors.length === 0, errors.join('; '));
  // Every line this change adds to static/shell.js ran in one of the pages.
  const shells = [...covered, ...signed].filter((e) => e.url.endsWith('/static/shell.js'));
  const changedShell = changedLines('tools/research/mcp-panel/static/shell.js');
  const missedShell = changedShell.filter((n) => !shells.some((e) => lineRan(e, n)));
  check(`every changed line of static/shell.js ran in Chrome (${changedShell.length} line(s))`, shells.length > 0 && missedShell.length === 0,
    missedShell.map((n) => `shell.js:${n}`).join(', '));
} catch (e) {
  check('the check ran to its end', false, e.stack || String(e));
} finally {
  if (browser) await browser.close();
  await stopAndWait();
}
// Nothing this run started outlives it: the panel stops its game, and the stand-in exits with it.
check('no process of this run is left (panel and stand-in game)', await until(async () => leftovers().length === 0, 10000), leftovers().join(', '));
if (results.some((r) => !r)) console.log(out.split('\n').slice(-40).join('\n'));
const failed = results.filter((r) => !r).length;
console.log(`${failed ? 'FAIL' : 'PASS'} mcp-approval-ui-check: ${results.length - failed}/${results.length}`);
process.exit(failed ? 1 : 0);

/** The added or modified executable lines of `file` since the base (comments and blank lines left out). */
function changedLines(file) {
  // --base, else $COVERAGE_BASE (CI: the pull request's base), else the merge base with origin/master;
  // a ref git does not hold (a push's all-zero `before`) falls through to the next.
  const holds = (r) => { try { execFileSync('git', ['-C', repo, 'cat-file', '-e', `${r}^{commit}`], { stdio: 'ignore' }); return true; } catch { return false; } };
  const ref = [opt('--base', ''), process.env.COVERAGE_BASE || ''].find((r) => r && holds(r))
    || execFileSync('git', ['-C', repo, 'merge-base', 'HEAD', 'origin/master'], { encoding: 'utf8' }).trim();
  const diff = execFileSync('git', ['-C', repo, 'diff', '-U0', ref, '--', file], { encoding: 'utf8' });
  const text = fs.readFileSync(path.join(repo, file), 'utf8').split('\n');
  const lines = [];
  for (const m of diff.matchAll(/^@@ -\S+ \+(\d+)(?:,(\d+))? @@/gm)) {
    const [start, count] = [Number(m[1]), m[2] === undefined ? 1 : Number(m[2])];
    for (let n = start; n < start + count; n++) {
      const t = (text[n - 1] || '').trim();
      if (t && !/^(\/\/|\/\*|\*)/.test(t)) lines.push(n);
    }
  }
  return lines;
}

/** Whether line `n` of a coverage entry ran: the innermost block range over its first non-blank
 *  character counted at least once. */
function lineRan(entry, n) {
  const src = entry.source.split('\n');
  let at = 0;
  for (let i = 0; i < n - 1; i++) at += src[i].length + 1;
  at += src[n - 1].length - src[n - 1].trimStart().length;
  let best = null;
  for (const f of entry.functions) {
    for (const r of f.ranges) {
      if (r.startOffset <= at && at < r.endOffset && (!best || r.endOffset - r.startOffset <= best.endOffset - best.startOffset)) best = r;
    }
  }
  return !!best && best.count > 0;
}
