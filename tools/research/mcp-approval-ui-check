  // passes once the page loaded it (mine); requiring a changed line failed every such change.
  check(`every changed line of static/approvals.js ran in Chrome (${lines.length} line(s))`, mine.length > 0 && missed.length === 0,
    missed.map((n) => `approvals.js:${n}`).join(', '));
}

/** The added or modified executable lines of `file` since the base (comments and blank lines left out). */
function changedLines(file) {
  // --base, else $COVERAGE_BASE (CI: the pull request's base), else the merge base with origin/master;
  // a ref git does not hold (a push's all-zero `before`) falls through to the next.
  const holds = (r) => { try { execFileSync('git', ['-C', repo, 'cat-file', '-e', `${r}^{commit}`], { stdio: 'ignore' }); return true; } catch { return false; } };
  const ref = [opt('--base', ''), process.env.COVERAGE_BASE || ''].find((r) => r && holds(r))
    || execFileSync('git', ['-C', repo, 'merge-base', 'HEAD', 'origin/master'], { encoding: 'utf8' }).trim();
  // A file git does not track yet counts whole, as it will once committed.
  const tracked = (() => { try { execFileSync('git', ['-C', repo, 'ls-files', '--error-unmatch', file], { stdio: 'ignore' }); return true; } catch { return false; } })();
  const diff = tracked ? execFileSync('git', ['-C', repo, 'diff', '-U0', ref, '--', file], { encoding: 'utf8' })
    : `@@ -0,0 +1,${fs.readFileSync(path.join(repo, file), 'utf8').split('\n').length} @@`;
  const text = fs.readFileSync(path.join(repo, file), 'utf8').split('\n');
  const lines = [];
  for (const m of diff.matchAll(/^@@ -\S+ \+(\d+)(?:,(\d+))? @@/gm)) {
    const [start, count] = [Number(m[1]), m[2] === undefined ? 1 : Number(m[2])];
    for (let n = start; n < start + count; n++) {
      const t = (text[n - 1] || '').trim();
      if (t && !/^(\/\/|\/\*|\*)/.test(t)) lines.push(n);
    }
  }
  return lines;
}

/** Whether line `n` of a coverage entry ran: the innermost block range over its first non-blank
 *  character counted at least once. */
function lineRan(entry, n) {
  const src = entry.source.split('\n');
  let at = 0;
  for (let i = 0; i < n - 1; i++) at += src[i].length + 1;
  at += src[n - 1].length - src[n - 1].trimStart().length;
  let best = null;
  for (const f of entry.functions) {
    for (const r of f.ranges) {
      if (r.startOffset <= at && at < r.endOffset && (!best || r.endOffset - r.startOffset <= best.endOffset - best.startOffset)) best = r;
    }
  }
  return !!best && best.count > 0;
}
