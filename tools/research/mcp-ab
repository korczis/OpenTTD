#!/usr/bin/env bash
# RESEARCH-ONLY: an A/B result for the owner's bot. Two headless games from the same seed and map,
# side by side: A starts the bot with the planner's air pair (mcp-plan by_mode.air), B without it
# (--no-plan-bot). Every game month both companies are read from the console's `companies` command
# (value, money, loan, vehicles by type), and the run ends after N months with a table and a JSON
# record under research/results/, so the result is evidence, not an impression.
#
# Every observation is of the company the arm's tested agent holds, never of whichever company the
# dump lists first: `--company N` names it (the console's #N, in both games), else each game says it
# (the one running company of the panel's AI in GET /api/bots, whose id is #N minus one). Its row is
# picked by number and founding year, so a rival, a company founded later or a bankrupt slot taken
# over never stands in for it; a month it is not in the game is recorded as its absence. When the
# company cannot be told (no AI named, several companies of it running, none founded in 120 s) the
# run refuses with exit 3 and writes no record.
#
# Every record's page carries charts between `<!-- ab-charts:begin -->` and `<!-- ab-charts:end -->`,
# derived from its JSON alone: company value per game month (A against B), A's lead over B per
# month, and the fleet per month (A against B) when every month has it; each month's mark opens that
# month's row of A's table (the lead's opens B's). A new run writes them; `--render` rewrites that
# region in every tracked research/results/ab-*.md (inserting it above the A table of a page written
# before the charts) and starts no game; `--render --check` writes nothing and exits 11 while a page
# is stale. `tools/surfaces/surfaces sync` runs the first, `surfaces check` the second (surfaces.toml,
# generator ab-charts), so a change of the charts reaches every page in one commit.
#
# Usage: tools/research/mcp-ab [--months 12] [--seed N] [--label text] [--company N]
#        tools/research/mcp-ab --render [--check]
# Exit: 0 the run completed (whatever its outcome) or the pages are current, 1 a stack did not come
# up, 2 bad arguments, 3 the tested company cannot be told, 11 (--render --check) a page's charts
# are stale.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MONTHS=12 SEED="$RANDOM" LABEL="" RENDER="" CHECK="" COMPANY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --months) MONTHS="${2:?}"; shift 2 ;;
    --seed) SEED="${2:?}"; shift 2 ;;
    --label) LABEL="${2:?}"; shift 2 ;;
    --company) COMPANY="${2:?}"; shift 2 ;;
    --render) RENDER=1; shift ;;
    --check) CHECK=1; shift ;;
    -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "usage: mcp-ab [--months N] [--seed N] [--label text] [--company N] | --render [--check]" >&2; exit 2 ;;
  esac
done
if [[ -n "$CHECK" && -z "$RENDER" ]]; then
  echo "mcp-ab: --check goes with --render" >&2; exit 2
fi
if [[ -n "$COMPANY" && ! "$COMPANY" =~ ^[1-9][0-9]*$ ]]; then
  echo "mcp-ab: --company is the console's company number (#N of \`companies\`, from 1), not '$COMPANY'" >&2; exit 2
fi
if [[ -n "$RENDER" ]]; then
  # The run's own Python (the heredoc below, as test_mcp_ab.py loads it), run for its pages only:
  # no stack, no game, nothing but research/results read and (without --check) its pages written.
  exec python3 -I - "$ROOT_DIR" "$CHECK" <<'RENDER'
import re
import sys
import types
from pathlib import Path

root = Path(sys.argv[1])
script = root / "tools" / "research" / "mcp-ab"
mod = types.ModuleType("mcp_ab")
exec(compile(re.search(r"<<'PY'\n(.*?)\nPY\n", script.read_text(), re.S)[1], f"{script} (heredoc)", "exec"), mod.__dict__)
sys.exit(mod.render_pages(root, check=bool(sys.argv[2])))
RENDER
fi
free() { python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
A_PANEL="$(free)" B_PANEL="$(free)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-ab.XXXXXX")"
PIDS=()
cleanup() {
  for p in ${PIDS[@]+"${PIDS[@]}"}; do kill -TERM "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
# No exec below: the record is written by a child python, so this trap still runs and both stacks
# stop when the run ends (an exec here once left every finished run's stacks running).
trap cleanup EXIT INT TERM

# No background strategist (research/mechanisms/strategist-and-blackboard.md): its MCP reads and
# console line would change a measured run's timing. A caller's own value wins.
export PRISMATIC_STRATEGIST="${PRISMATIC_STRATEGIST:-0}"
echo "==> A (planner's air pair) on :$A_PANEL, B (no planner) on :$B_PANEL, seed $SEED, $MONTHS months"
"$ROOT_DIR/tools/research/mcp-e2e" --no-gui --no-browser --seed "$SEED" --panel-port "$A_PANEL" \
  --mcp-port "$(free)" --game-port "$(free)" > "$TMP/a.log" 2>&1 &
PIDS+=($!)
"$ROOT_DIR/tools/research/mcp-e2e" --no-gui --no-browser --seed "$SEED" --no-plan-bot --panel-port "$B_PANEL" \
  --mcp-port "$(free)" --game-port "$(free)" > "$TMP/b.log" 2>&1 &
PIDS+=($!)
for port in "$A_PANEL" "$B_PANEL"; do
  for ((i = 0; i < 180; i++)); do
    curl -s "http://127.0.0.1:$port/api/status" 2>/dev/null | grep -q '"ai_started": true' && break
    sleep 2
  done
  curl -s "http://127.0.0.1:$port/api/status" | grep -q '"ai_started": true' || { echo "mcp-ab: the stack on :$port did not come up (logs in $TMP)" >&2; exit 1; }
done
# The run's Python. Everything is a function and the run itself is under __main__, so --render and
# tools/research/test_mcp_ab.py load the same text without starting anything.
python3 -I - "$A_PANEL" "$B_PANEL" "$MONTHS" "$SEED" "$LABEL" "$ROOT_DIR" "$COMPANY" <<'PY'
import json
import math
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROW = re.compile(r"#:(\d+)\(.*?\)\s+Company Name: '([^']*)'\s+Year Founded: (\d+)\s+Money: (-?\d+)\s+Loan: (\d+)\s+Value: (-?\d+)\s+\(T:(\d+), R:(\d+), P:(\d+), S:(\d+)\)")
# The page's two month tables sit under these headings; a chart's mark opens a row of one of them.
A_HEADING, B_HEADING = "A: with the planner's air pair", "B: without the planner"


def post(port, path, body):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())


def get(port, path):
    with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=30) as r:
        return json.loads(r.read())


class Unbound(Exception):
    """The company the tested agent holds cannot be told: the run refuses rather than read another."""


def companies(output):
    """Every company of one `companies` dump (the console's output lines), in its order; `id` is the
    console's #N."""
    text = " ".join(l if isinstance(l, str) else str(l) for l in output)
    return [dict(zip(("id", "name", "founded", "money", "loan", "value", "trains", "road", "planes", "ships"),
                     (int(m[0]), m[1], int(m[2]), int(m[3]), int(m[4]), int(m[5]), int(m[6]), int(m[7]), int(m[8]), int(m[9]))))
            for m in ROW.findall(text)]


def dump(port):
    return companies(post(port, "/api/console", {"command": "companies", "wait": 1.0}).get("output", []))


def observe(rows, tested):
    """The tested company's observation in one dump, naming it (`company`: its #N): its row when the
    dump holds that number with the founding year it was bound with; else its absence, saying why (it
    left the game, or its number now belongs to a company founded since). Never another company's row."""
    n, founded = tested["company"], tested.get("founded")
    for r in rows:
        if r["id"] != n:
            continue
        if founded is not None and r["founded"] != founded:
            return {"company": n, "present": False,
                    "note": f"#{n} is now '{r['name']}', founded {r['founded']}: not the tested company (founded {founded})"}
        return dict(r, company=n, present=True)
    return {"company": n, "present": False, "note": f"#{n} is not among the game's companies"}


def snapshot(port, tested):
    return observe(dump(port), tested)


def bind(port, given="", tries=60, pause=2.0):
    """The company the arm's tested agent holds, as {company (#N), name, founded, from}: `given`
    (--company) when set, else the one running company of the panel's AI (GET /api/status `ai`,
    GET /api/bots `running`, whose id is #N minus one), waited for until the dump holds it. Raises
    Unbound when it cannot be told: no AI named, several companies of it, no /api/bots, or none in
    the dump after tries * pause seconds."""
    why = ""
    for i in range(tries):
        if i:
            time.sleep(pause)
        if given:
            n, source = int(given), "--company"
        else:
            ai = get(port, "/api/status").get("ai") or ""
            if not ai:
                raise Unbound("the panel names no AI it started (GET /api/status `ai`): pass --company N")
            try:
                running = get(port, "/api/bots").get("running") or []
            except (urllib.error.URLError, TimeoutError, ValueError) as e:
                raise Unbound(f"GET /api/bots did not answer ({e}): pass --company N") from e
            mine = sorted(r["id"] + 1 for r in running
                          if r.get("ai") == ai and r.get("running") is not False and isinstance(r.get("id"), int))
            if len(mine) > 1:
                raise Unbound(f"{len(mine)} running companies of {ai} ({', '.join(f'#{m}' for m in mine)}): pass --company N")
            if not mine:
                why = f"no running company of {ai} in GET /api/bots"
                continue
            n, source = mine[0], f"GET /api/bots: the one running company of {ai}"
        row = next((r for r in dump(port) if r["id"] == n), None)
        if row:
            return {"company": n, "name": row["name"], "founded": row["founded"], "from": source}
        why = f"#{n} is not among the game's companies"
    raise Unbound(f"{why} after {tries * pause:g} s")


def month_count(port):
    return len(get(port, "/api/events?since=0&kinds=game.month&limit=1000").get("events", []))


# ---------------------------------------------------------------------- the charts

# The charts of a page sit between these markers: tools/surfaces/surfaces check refuses a chart
# outside a generated region, and --render rewrites exactly this region of every page.
CHARTS_BEGIN, CHARTS_END = "<!-- ab-charts:begin -->", "<!-- ab-charts:end -->"
# The NoirGFX palette (tools/research/noirgfx/style.toml) the README scoreboard and the duels draw in.
STYLE = Path("tools") / "research" / "noirgfx" / "style.toml"
NAMES = ("A (with planner)", "B (no planner)")


def github_slug(text):
    """A heading's anchor as GitHub and tools/surfaces/surfaces.py (github_slug) derive it."""
    return "".join(ch for ch in text.lower() if ch.isalnum() or ch in "-_ ").replace(" ", "-")


def mermaid_num(v):
    """Plain digits, never an exponent (Mermaid cannot parse 1.0e+08); as tools/surfaces/surfaces.py."""
    if float(v).is_integer():
        return str(int(v))
    return f"{v:.6f}".rstrip("0").rstrip(".")


def mermaid_xy(title, labels, series, y_title, palette, links=None):
    """A Mermaid xychart-beta: a bar for the first series, a line for each further one. GitHub draws
    it; the site reads it back and draws it with ECharts, naming the series from `%% series:` and
    opening each mark's `%% links:` target (tools/surfaces/README.md "Charts"). As mcp-duel draws."""
    label = lambda t: str(t).replace('"', "'")
    values = [v for _, vals in series for v in vals]
    whole = all(float(v).is_integer() for v in values)  # a count's axis ends on a whole number

    def span(v):
        edge = float(f"{v * 1.1:.3g}")
        return mermaid_num((math.ceil(edge) if edge > 0 else math.floor(edge)) if whole else edge) if v else "0"
    lines = ["```mermaid", "---", "config:", "  xyChart:", "    width: 900", "    height: 360",
             "  themeVariables:", "    xyChart:", f'      plotColorPalette: "{palette}"', "---",
             "xychart-beta", f'    title "{label(title)}"', "    x-axis [" + ", ".join(f'"{label(x)}"' for x in labels) + "]",
             f"    %% series: {' | '.join(label(n) for n, _ in series)}"]
    if links:
        lines.append(f"    %% links: {' | '.join(links)}")
    lines.append(f'    y-axis "{label(y_title)}" {span(min(values + [0]))} --> {span(max(values + [1]))}')
    lines += [f"    {'bar' if i == 0 else 'line'} [{', '.join(mermaid_num(v) for v in vals)}]" for i, (_, vals) in enumerate(series)]
    return "\n".join(lines + ["```"])


def fleet(r):
    """A company's vehicles in one month (trains + road + planes + ships), None when not read."""
    parts = [r.get(k) for k in ("trains", "road", "planes", "ships")]
    return sum(int(x) for x in parts) if all(x is not None for x in parts) else None


def paired_months(rec):
    """The months both games read a company value in, in order, each as (month, A's row, B's row):
    a month one side missed (its stack lagged, its console answered nothing) is left out of both."""
    sides = [{r["month"]: r for r in (rec.get("series") or {}).get(k) or [] if r.get("value") is not None}
             for k in ("A", "B")]
    return [(m, sides[0][m], sides[1][m]) for m in sorted(set(sides[0]) & set(sides[1]))]


def charts(rec, page=None, root=Path(".")):
    """The record's charts, every number from its series: company value per month, A against B; A's
    lead over B per month; and the fleet per month when every month has it. With `page` (the page's
    file name) each month's mark opens that month's row of A's table (the lead's of B's:
    ?col=Month&filter=N#heading, which the site filters)."""
    import tomllib
    pal = tomllib.loads((Path(root) / STYLE).read_text())["palette"]
    palette = f"{pal['signal']}, #8a8a8a, {pal['ink']}, {pal['paper']}"
    months, seed = paired_months(rec), rec["seed"]
    out = [CHARTS_BEGIN, "<!-- generated by tools/research/mcp-ab from this record's JSON; "
           "`mcp-ab --render` rewrites it, `mcp-ab --render --check` fails while it is stale -->", ""]
    if not months:
        return "\n".join(out + ["No month was read in both games: nothing to chart.", "", CHARTS_END])
    labels = [str(a.get("date") or b.get("date") or "")[:7] or str(m) for m, a, b in months]
    row = lambda heading: [f"{page}?col=Month&filter={m}#{github_slug(heading)}" for m, _, _ in months] if page else None
    a_links, b_links = row(A_HEADING), row(B_HEADING)
    values = [[int(a["value"]) for _, a, _ in months], [int(b["value"]) for _, _, b in months]]
    out += [mermaid_xy(f"Company value per game month, seed {seed}: A (with planner) vs B (no planner)", labels,
                       list(zip(NAMES, values)), "Company value", palette, a_links), ""]
    lead = [x - y for x, y in zip(*values)]
    out += [mermaid_xy(f"A's lead in company value over B per game month, seed {seed} (negative: B ahead)", labels,
                       [("A minus B", lead)], "A minus B", palette, b_links), ""]
    fleets = [[fleet(a) for _, a, _ in months], [fleet(b) for _, _, b in months]]
    if all(v is not None for f in fleets for v in f):
        out += [mermaid_xy(f"Vehicles per game month, seed {seed}: A (with planner) vs B (no planner)", labels,
                           list(zip(NAMES, fleets)), "Vehicles", palette, a_links), ""]
    return "\n".join(out + [CHARTS_END])


def with_charts(text, region):
    """A page with its charts region replaced, or, on a page written before the charts, inserted
    above its A table's heading (at the end when it has none)."""
    if CHARTS_BEGIN in text and CHARTS_END in text:
        a, b = text.index(CHARTS_BEGIN), text.index(CHARTS_END) + len(CHARTS_END)
        return text[:a] + region + text[b:]
    m = re.search(r"^## " + re.escape(A_HEADING) + r"$", text, re.M)
    if m:
        return text[:m.start()] + region + "\n\n" + text[m.start():]
    return text.rstrip("\n") + "\n\n" + region + "\n"


def tracked_records(root):
    """The A/B records the next commit can hold, as mcp-duel's: what git tracks plus new files it would
    not ignore; inside a git hook (GIT_INDEX_FILE) only the index; outside a git checkout of root
    every record on disk."""
    results = Path(root) / "research" / "results"
    env = dict(os.environ)
    if env.get("GIT_INDEX_FILE"):
        env["GIT_INDEX_FILE"] = os.path.abspath(env["GIT_INDEX_FILE"])
    sources = ["--cached"] + ([] if env.get("GIT_INDEX_FILE") else ["--others", "--exclude-standard"])
    git = lambda *a: subprocess.run(["git", *a], cwd=results, env=env, check=True, capture_output=True, text=True).stdout
    try:
        if Path(git("rev-parse", "--show-toplevel").strip()).resolve() != Path(root).resolve():
            raise ValueError("not a checkout of root")
        listed = git("ls-files", "-z", *sources, "--", ".").split("\0")
    except (OSError, ValueError, subprocess.CalledProcessError):
        return sorted(results.glob("ab-*.json")) if results.is_dir() else []
    return sorted(results / f for f in listed if f and "/" not in f and Path(f).match("ab-*.json") and (results / f).exists())


def render_pages(root, check=False):
    """--render: every tracked record's page with its charts derived from its JSON (the rest of the
    page, its reading of that run, is kept as written). With check, write nothing and return 11 while
    a page would change (Majordomus exit codes)."""
    stale = []
    records = tracked_records(root)
    for path in records:
        md = path.with_suffix(".md")
        if not md.is_file():
            continue
        text = md.read_text()
        new = with_charts(text, charts(json.loads(path.read_text()), md.name, root))
        if new != text:
            stale.append(md)
            if not check:
                md.write_text(new)
    rel = lambda p: p.relative_to(root).as_posix()
    if check:
        for md in stale:
            print(f"{rel(md)}: its charts are not derived from {md.with_suffix('.json').name} "
                  "(run tools/research/mcp-ab --render)", file=sys.stderr)
        return 11 if stale else 0
    print(f"mcp-ab --render: {len(stale)} of {len(records)} page(s) rewritten")
    return 0


def tested_line(result):
    """Which company each arm observed and how it was told (the record's `tested`)."""
    tested = result.get("tested") or {}
    if not tested:
        return "the record does not say which"
    return "; ".join(f"{k} #{t['company']} '{t['name']}' (founded {t['founded']}, from {t['from']})"
                     for k, t in sorted(tested.items()))


def markdown(result, page=None, root=Path(".")):
    """The record's reading. Its charts are charts(result): what --render rewrites later."""
    seed, months, label, plan, last = result["seed"], result["months"], result["label"], result["plan"], result["final"]
    who = lambda r: f"#{r['company']} {r.get('name', '(absent)')}" if "company" in r else ""
    table = lambda side: "\n".join(
        f"| {r['month']} | {r.get('date','')} | {who(r)} | {r.get('value','')} | {r.get('money','')} | {r.get('loan','')} | {r.get('road','')} | {r.get('planes','')} |"
        for r in result["series"][side])
    return f"""# A/B: the planner's air pair vs no planner (seed {seed}, {months} months)

Generated by `tools/research/mcp-ab`{(' (' + label + ')') if label else ''}. Both games use the same seed and map and start the same
bot (PrismaticAI). A starts it with the planner's best air pair (`mcp-plan` by_mode.air); B starts it
without one. Figures come from the console's `companies` command, once per game month, each of the
company the arm's bot holds: {tested_line(result)}.

{plan.get('note', 'no planner note recorded')}

**Final company value: A {last['A'].get('value')} vs B {last['B'].get('value')} (difference {result['value_delta']}).**

{charts(result, page, root)}

## {A_HEADING}

| Month | Date | Company | Value | Money | Loan | Road vehicles | Aircraft |
|---|---|---|---|---|---|---|---|
{table("A")}

## {B_HEADING}

| Month | Date | Company | Value | Money | Loan | Road vehicles | Aircraft |
|---|---|---|---|---|---|---|---|
{table("B")}
"""


def main(argv):
    a_port, b_port, months, seed, label, root = argv[1], argv[2], int(argv[3]), argv[4], argv[5], argv[6]
    tested = {}
    for name, port in (("A", a_port), ("B", b_port)):
        try:
            tested[name] = bind(port, argv[7] if len(argv) > 7 else "")
        except Unbound as e:
            print(f"mcp-ab: {name}: refused, the tested company cannot be told ({e}); no other company's "
                  "figures are reported in its place", file=sys.stderr)
            sys.exit(3)
        print(f"{name} observes #{tested[name]['company']} '{tested[name]['name']}' ({tested[name]['from']})", flush=True)
    plan = {}
    for e in get(a_port, "/api/status")["events"]:
        if e["kind"] == "ai" and e["text"].startswith("planner:"):
            plan = {"note": e["text"]}
    series = {"A": [], "B": []}
    start = {p: month_count(p) for p in (a_port, b_port)}
    seen = dict(start)
    while min(seen[p] - start[p] for p in (a_port, b_port)) < months:
        time.sleep(20)
        for name, port in (("A", a_port), ("B", b_port)):
            n = month_count(port)
            if n > seen[port]:
                seen[port] = n
                snap = snapshot(port, tested[name])
                date = get(port, "/api/resources/game/state").get("game_date")
                series[name].append({"month": n - start[port], "date": date, **snap})
                print(f"{name} month {n - start[port]:>2} {date}: {snap}", flush=True)

    last = {k: (v[-1] if v else {}) for k, v in series.items()}
    # The bot's own account of each game (every ai.log line the panel recorded), so a result can be
    # explained afterwards: what it built, what failed and why.
    bot_log = {}
    for name, port in (("A", a_port), ("B", b_port)):
        try:
            bot_log[name] = [e["data"]["text"] for e in get(port, "/api/events?since=0&kinds=ai.log&limit=5000").get("events", [])]
        except Exception as e:  # noqa: BLE001
            bot_log[name] = [f"not read: {e}"]
    result = {"experiment": "planner air pair (A) vs no planner (B)", "label": label, "seed": int(seed), "months": months,
              "plan": plan, "tested": tested, "final": last, "series": series,
              "value_delta": (last["A"].get("value", 0) - last["B"].get("value", 0)), "bot_log": bot_log}
    stamp = time.strftime("%Y%m%dT%H%M%S")
    outdir = f"{root}/research/results"
    os.makedirs(outdir, exist_ok=True)
    name = f"ab-{stamp}-seed{seed}"
    base = f"{outdir}/{name}"
    with open(base + ".json", "w") as f:
        json.dump(result, f, indent=2)
    with open(base + ".md", "w") as f:
        f.write(markdown(result, f"{name}.md", root))
    print(f"\nmcp-ab: A value {last['A'].get('value')} vs B {last['B'].get('value')} (delta {result['value_delta']}); {base}.md")


if __name__ == "__main__":
    main(sys.argv)
PY
